---
interface Feature {
  icon: string;
  title: string;
  desc: string;
  delay?: string;
}

const features: Feature[] = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>`,
    title: "Run Your Favorite Coding Agents",
    desc: "Use OpenAI Codex, Claude Code, and OpenCode on the machine where your code already lives. No stripped-down mobile workflow.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>`,
    title: "Access Real Project Files",
    desc: "Browse, open, edit, rename, and manage the files on your dev machine directly from your phone, right inside your mobile editor.",
    delay: "reveal-delay-1",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>`,
    title: "Your Terminal, Anywhere",
    desc: "Open a live terminal to your machine, run commands, kick off builds, inspect logs, and handle quick fixes without waiting to get back to your desk.",
    delay: "reveal-delay-2",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>`,
    title: "Built For Coding On The Go",
    desc: "When you need to review a PR, patch a bug, or keep momentum while traveling, Shellular gives you a usable mobile workflow instead of a compromised fallback.",
    delay: "reveal-delay-3",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path></svg>`,
    title: "Fast To Start",
    desc: "Start the CLI, connect from your phone, and get into your environment in seconds. No extra machine setup every time you want to use it.",
    delay: "reveal-delay-4",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="14" x2="23" y2="14"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="14" x2="4" y2="14"></line></svg>`,
    title: "Stay In Your Existing Workflow",
    desc: "Keep using the repos, tools, shells, and agent-driven workflows you already rely on. Shellular extends your setup to your phone instead of replacing it.",
    delay: "reveal-delay-5",
  },
];
---

<section id="features">
  <div class="features-header">
    <div class="section-label reveal">Everything you need</div>
    <h2 class="section-title reveal reveal-delay-1">Your dev environment,<br /><span>untethered</span></h2>
    <p class="section-sub reveal reveal-delay-2">
      Everything you need to stay productive from your phone: your coding agents, your terminal, your files, and the
      machine that already has your tools and repos.
    </p>
  </div>

  <div class="features-grid">
    {
      features.map(({ icon, title, desc, delay }) => (
        <div class={`feat-card reveal ${delay ?? ""}`}>
          <div class="feat-icon" aria-hidden="true" set:html={icon} />
          <div class="feat-title">{title}</div>
          <div class="feat-desc">{desc}</div>
        </div>
      ))
    }
  </div>
</section>

<style>
  #features {
    padding: clamp(70px, 10vw, 110px) clamp(16px, 8vw, 80px) clamp(60px, 8vw, 100px);
    max-width: 1100px;
    margin: 0 auto;
  }

  .features-header {
    text-align: center;
    margin-bottom: 52px;
  }

  .features-header .section-sub {
    margin: 0 auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }

  .feat-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 28px;
    transition:
      border-color 0.3s,
      transform 0.3s,
      box-shadow 0.3s;
  }

  .feat-card:hover {
    border-color: rgba(214, 194, 161, 0.28);
    transform: translateY(-4px);
    box-shadow: 0 20px 44px rgba(0, 0, 0, 0.3);
  }

  .feat-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(214, 194, 161, 0.18), rgba(138, 116, 92, 0.16));
    border: 1px solid rgba(214, 194, 161, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    margin-bottom: 18px;
    flex-shrink: 0;
  }

  .feat-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .feat-desc {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  @media (max-width: 600px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
