---
import { Bot, FolderCode, Globe, FileTerminal } from "@lucide/astro";

interface Feature {
  Icon: typeof Bot;
  title: string;
  desc: string;
  delay?: string;
}

const features: Feature[] = [
  {
    Icon: Bot,
    title: "Run the agents you already use",
    desc: "Use Claude Code, Codex, OpenCode, Pi, and other supported agents from a native UI in the app, while they keep running on the machine where your code already lives.",
  },
  {
    Icon: FileTerminal,
    title: "Keep a real terminal in reach",
    desc: "Run commands, restart services, inspect logs, and handle small fixes from your phone without waiting to get back to your desk.",
    delay: "reveal-delay-1",
  },
  {
    Icon: Globe,
    title: "Open local apps remotely",
    desc: "Reach dev servers and browser previews running on your machine, with built-in inspect, JavaScript console, and network tools on your phone.",
    delay: "reveal-delay-2",
  },
  {
    Icon: FolderCode,
    title: "Work in the same repos and files",
    desc: "Browse and manage the actual project files on your machine instead of moving to a separate mobile-only workflow.",
    delay: "reveal-delay-3",
  },
];
---

<section id="features">
  <div class="features-header">
    <div class="section-label reveal">What you can do</div>
    <h2 class="section-title reveal reveal-delay-1">Use your development machine from <span>your phone</span></h2>
    <p class="section-sub reveal reveal-delay-2">
      Shellular keeps the machine, tools, repos, and agents you already rely on reachable when you are away from your
      desk.
    </p>
  </div>

  <div class="features-grid">
    {
      features.map(({ Icon, title, desc, delay }) => (
        <div class={`feat-card reveal ${delay ?? ""}`}>
          <div class="feat-header">
            <div class="feat-icon">
              <Icon size={18} aria-hidden="true" />
            </div>
            <div class="feat-title">{title}</div>
          </div>
          <div class="feat-desc">{desc}</div>
        </div>
      ))
    }
  </div>
</section>

<style>
  #features {
    padding: clamp(70px, 10vw, 110px) clamp(16px, 8vw, 80px) clamp(60px, 8vw, 100px);
    max-width: 1100px;
    margin: 0 auto;
  }

  .features-header {
    text-align: center;
    margin-bottom: 52px;
  }

  .features-header .section-sub {
    margin: 0 auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .feat-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition:
      border-color 0.25s,
      transform 0.25s,
      box-shadow 0.25s;
    min-height: 100%;
  }

  .feat-card:hover {
    border-color: rgba(var(--brand-gold-rgb), 0.3);
    transform: translateY(-3px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.28);
  }

  .feat-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .feat-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(var(--brand-gold-rgb), 0.15), rgba(var(--brand-bronze-rgb), 0.12));
    border: 1px solid rgba(var(--brand-gold-rgb), 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    flex-shrink: 0;
  }

  .feat-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .feat-desc {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.7;
  }

  @media (max-width: 720px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
