---

---

<div id="waitlist-modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="waitlist-title">
  <div class="modal-content">
    <div class="modal-header">
      <h2 id="waitlist-title" class="modal-title">Join the Waitlist</h2>
      <button id="close-waitlist-btn" class="close-btn" aria-label="Close">×</button>
    </div>

    <div id="waitlist-form-content">
      <div id="waitlist-error" class="error-msg" style="display: none;"></div>
      <form id="waitlist-form" class="wl-form">
        <div class="form-group">
          <label for="waitlist-name" class="form-label">Name</label>
          <input type="text" id="waitlist-name" class="form-input" placeholder="Your name" required />
        </div>
        <div class="form-group">
          <label for="waitlist-email" class="form-label">Email</label>
          <input type="email" id="waitlist-email" class="form-input" placeholder="your@email.com" required />
        </div>
        <div class="form-group">
          <label for="waitlist-social" class="form-label">Social Profile <span class="optional">(Optional)</span></label
          >
          <input type="url" id="waitlist-social" class="form-input" placeholder="https://twitter.com/yourhandle" />
        </div>
        <div class="form-group">
          <label class="form-label">Which platforms do you want early access on?</label>
          <div class="platform-options">
            <label class="platform-checkbox">
              <input type="checkbox" id="platform-android" value="android" name="platform" />
              <span class="checkbox-visual"></span>
              <span class="checkbox-label">
                Android
                <span class="platform-sub">Play Store Beta</span>
              </span>
            </label>
            <label class="platform-checkbox">
              <input type="checkbox" id="platform-ios" value="ios" name="platform" />
              <span class="checkbox-visual"></span>
              <span class="checkbox-label">
                iOS
                <span class="platform-sub">TestFlight</span>
              </span>
            </label>
          </div>
          <div id="platform-error" class="platform-error" style="display: none;">
            Please select at least one platform
          </div>
        </div>
        <button type="submit" class="submit-btn">Join Waitlist</button>
      </form>
    </div>

    <div id="waitlist-success-content" style="display: none; align-items: center; justify-content: center; width: 100%;">
      <div class="success">
        <div class="success-icon">✓</div>
        <div class="success-message">You're on the waitlist!</div>
        <div class="success-subtext">We'll keep you updated about Shellular.</div>
      </div>
    </div>
  </div>
</div>

<style>
  .modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .modal.active {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal-content {
    background: rgba(24, 24, 27, 0.98);
    border: 1px solid rgba(214, 194, 161, 0.2);
    border-radius: 24px;
    padding: 40px;
    max-width: 500px;
    width: 90%;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.4);
    animation: slideUp 0.3s ease-out;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
  }

  .modal-title {
    font-size: 24px;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0;
  }

  .close-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 24px;
    cursor: pointer;
    transition: color 0.2s;
    padding: 0;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .close-btn:hover {
    color: var(--accent);
  }

  .wl-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .form-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .optional {
    font-weight: 400;
    color: var(--text-muted);
  }

  .form-input {
    background: rgba(245, 241, 232, 0.04);
    border: 1px solid rgba(214, 194, 161, 0.18);
    border-radius: 12px;
    padding: 12px 14px;
    font-size: 14px;
    color: var(--text-primary);
    font-family: "Inter", sans-serif;
    transition:
      border-color 0.2s,
      background 0.2s;
  }

  .form-input:focus {
    outline: none;
    border-color: rgba(214, 194, 161, 0.4);
    background: rgba(245, 241, 232, 0.06);
  }

  .form-input::placeholder {
    color: rgba(245, 241, 232, 0.4);
  }

  .platform-options {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .platform-checkbox {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    flex: 1;
    min-width: 140px;
  }

  .platform-checkbox input[type="checkbox"] {
    display: none;
  }

  .checkbox-visual {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(214, 194, 161, 0.3);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background-color 0.2s,
      border-color 0.2s;
    flex-shrink: 0;
  }

  .platform-checkbox input[type="checkbox"]:checked + .checkbox-visual {
    background: linear-gradient(135deg, #d6c2a1 0%, #c9b394 100%);
    border-color: #d6c2a1;
  }

  .platform-checkbox input[type="checkbox"]:checked + .checkbox-visual::after {
    content: "✓";
    color: #140f0a;
    font-size: 12px;
    font-weight: bold;
  }

  .checkbox-label {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-primary);
    user-select: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .platform-sub {
    font-size: 11px;
    font-weight: 400;
    color: var(--text-muted);
  }

  .platform-error {
    background: rgba(220, 38, 38, 0.1);
    border: 1px solid rgba(220, 38, 38, 0.3);
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 12px;
    color: #fca5a5;
    margin-top: 4px;
  }

  .submit-btn {
    background: var(--grad-accent-btn);
    color: #140f0a;
    border: none;
    border-radius: 12px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition:
      opacity 0.2s,
      transform 0.2s;
    margin-top: 8px;
  }

  .submit-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    opacity: 0.92;
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .error-msg {
    background: rgba(220, 38, 38, 0.1);
    border: 1px solid rgba(220, 38, 38, 0.3);
    border-radius: 8px;
    padding: 12px;
    font-size: 13px;
    color: #fca5a5;
    margin-bottom: 16px;
  }

  .success {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 32px 0;
    width: 100%;
  }

  .success-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: linear-gradient(135deg, #d6c2a1 0%, #c9b394 100%);
    color: #140f0a;
    font-size: 28px;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    animation: successPulse 0.5s ease-out;
  }

  @keyframes successPulse {
    from {
      opacity: 0;
      transform: scale(0.8);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .success-message {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .success-subtext {
    font-size: 14px;
    color: var(--text-muted);
  }
</style>

<script>
  const WAITLIST_KEY = "shellular_waitlist_submitted";
  const API_URL = new URL(import.meta.env.PUBLIC_API_URL || "https://api.shellular.dev");
  API_URL.pathname = "/api/waitlist";

  const modal = document.getElementById("waitlist-modal")!;
  const openBtn = document.getElementById("open-waitlist-btn") as HTMLButtonElement;
  const closeBtn = document.getElementById("close-waitlist-btn")!;
  const form = document.getElementById("waitlist-form") as HTMLFormElement;
  const formContent = document.getElementById("waitlist-form-content")!;
  const successContent = document.getElementById("waitlist-success-content")!;
  const errorDiv = document.getElementById("waitlist-error")!;
  const platformError = document.getElementById("platform-error")!;

  function closeModal() {
    modal.classList.remove("active");
    formContent.style.display = "flex";
    successContent.style.display = "none";
    errorDiv.style.display = "none";
    platformError.style.display = "none";
    form.reset();
  }

  // Mark button as already-joined on load
  if (localStorage.getItem(WAITLIST_KEY)) {
    openBtn.innerHTML = "&#x2713;&nbsp;&nbsp;You're on the waitlist!";
    openBtn.disabled = true;
  }

  openBtn.addEventListener("click", () => modal.classList.add("active"));
  closeBtn.addEventListener("click", closeModal);
  modal.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const name = (document.getElementById("waitlist-name") as HTMLInputElement).value.trim();
    const email = (document.getElementById("waitlist-email") as HTMLInputElement).value.trim();
    const social = (document.getElementById("waitlist-social") as HTMLInputElement).value.trim();
    const platformCheckboxes = document.querySelectorAll(
      'input[name="platform"]:checked',
    ) as NodeListOf<HTMLInputElement>;
    const platforms = Array.from(platformCheckboxes).map((cb) => cb.value);

    // Validate platform selection
    if (platforms.length === 0) {
      platformError.style.display = "block";
      return;
    }
    platformError.style.display = "none";

    const submitBtn = form.querySelector(".submit-btn") as HTMLButtonElement;
    submitBtn.disabled = true;
    submitBtn.textContent = "Joining...";

    try {
      const res = await fetch(API_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, email, social: social || undefined, platforms }),
      });

      if (!res.ok) throw new Error("Server error");

      const data = await res.json();

      if (data.alreadyJoined) {
        localStorage.setItem(WAITLIST_KEY, JSON.stringify({ name, email, timestamp: new Date().toISOString() }));
        openBtn.innerHTML = "&#x2713;&nbsp;&nbsp;You're on the waitlist!";
        openBtn.disabled = true;
        formContent.style.display = "none";
        const successMsg = successContent.querySelector(".success-message")!;
        successMsg.textContent = "You're already on the waitlist!";
        successContent.style.display = "flex";
        setTimeout(closeModal, 3000);
        return;
      }

      localStorage.setItem(WAITLIST_KEY, JSON.stringify({ name, email, timestamp: new Date().toISOString() }));
      openBtn.innerHTML = "&#x2713;&nbsp;&nbsp;You're on the waitlist!";
      openBtn.disabled = true;

      formContent.style.display = "none";
      successContent.style.display = "flex";

      setTimeout(closeModal, 3000);
    } catch {
      errorDiv.textContent = "Failed to join. Please try again.";
      errorDiv.style.display = "block";
      submitBtn.disabled = false;
      submitBtn.textContent = "Join Waitlist";
    }
  });
</script>
