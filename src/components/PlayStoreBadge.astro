---
import { PLAY_STORE_URL } from "@/data/appLinks";

interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
const rootClassName = ["app-badge", className].filter(Boolean).join(" ");
---

<a
  href={PLAY_STORE_URL}
  class={rootClassName}
  aria-label="Get it on Google Play"
  target="_blank"
  rel="noopener noreferrer"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 640 640"
    fill="currentColor"
    width="20"
    height="20"
    aria-hidden="true"
  >
    <path
      d="M389.6 298.3L168.9 77L449.7 238.2L389.6 298.3zM111.3 64C98.3 70.8 89.6 83.2 89.6 99.3L89.6 540.6C89.6 556.7 98.3 569.1 111.3 575.9L367.9 319.9L111.3 64zM536.5 289.6L477.6 255.5L411.9 320L477.6 384.5L537.7 350.4C555.7 336.1 555.7 303.9 536.5 289.6zM168.9 563L449.7 401.8L389.6 341.7L168.9 563z"
    ></path>
  </svg>
  <div class="badge-text">
    <span class="badge-label">Get it on</span>
    <span class="badge-store">Google Play</span>
  </div>
</a>

<style>
  .app-badge {
    display: inline-flex;
    align-items: center;
    text-align: left;
    gap: 10px;
    padding: 10px 18px;
    background-color: var(--ink-900);
    border: 1px solid var(--ink-900);
    border-radius: var(--radius-pill);
    text-decoration: none;
    color: var(--cream-100);
    transition:
      background-color 0.2s,
      transform 0.2s,
      box-shadow 0.2s;
    box-shadow: 0 6px 18px rgba(26, 22, 21, 0.18);
  }

  .app-badge:hover {
    background: var(--ink-700);
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(26, 22, 21, 0.24);
  }

  .badge-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .badge-label {
    font-size: 10px;
    color: rgba(245, 241, 232, 0.7);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .badge-store {
    font-size: 14px;
    font-weight: 700;
    color: var(--cream-100);
  }
</style>
