---
import ShellularLogo from "./ShellularLogo.astro";
import { ENTERPRISE_CALENDAR_URL } from "@/data/appLinks";

const columns = [
  {
    heading: "Product",
    links: [
      { label: "Features", href: "/#features" },
      { label: "Security", href: "/#security" },
      { label: "Docs", href: "/docs" },
      { label: "Enterprise", href: ENTERPRISE_CALENDAR_URL, external: true },
    ],
  },
  {
    heading: "Compare",
    links: [
      { label: "vs Claude Remote Control", href: "/shellular-vs-claude-remote-control" },
      { label: "vs Codex Mobile", href: "/shellular-vs-codex-mobile" },
    ],
  },
  {
    heading: "Company",
    links: [
      { label: "About", href: "/about" },
      { label: "Contact", href: "/contact" },
      { label: "Privacy", href: "/privacy" },
      { label: "Terms", href: "/terms" },
    ],
  },
];

const social = [
  { label: "GitHub", href: "https://github.com/shellular-org" },
  { label: "X", href: "https://x.com/shellular_dev" },
  { label: "LinkedIn", href: "https://www.linkedin.com/company/120924584/admin/dashboard/" },
];
---

<!-- Final CTA banner -->
<section class="cta-banner">
  <div class="cta-clouds" aria-hidden="true">
    <svg class="cta-cloud cta-cloud-1" viewBox="0 0 200 80">
      <path d="M40 60 Q20 60 20 45 Q20 30 38 30 Q44 14 64 16 Q82 14 92 30 Q108 26 118 38 Q138 36 144 52 Q150 64 138 68 L52 68 Q40 68 40 60 Z" fill="#ffffff" opacity="0.85"/>
    </svg>
    <svg class="cta-cloud cta-cloud-2" viewBox="0 0 200 80">
      <path d="M40 60 Q20 60 20 45 Q20 30 38 30 Q44 14 64 16 Q82 14 92 30 Q108 26 118 38 Q138 36 144 52 Q150 64 138 68 L52 68 Q40 68 40 60 Z" fill="#ffffff" opacity="0.7"/>
    </svg>
  </div>
  <div class="cta-inner">
    <h2 class="cta-title reveal">
      Ready to take your stack
      <span>with you?</span>
    </h2>
    <p class="cta-sub reveal reveal-delay-1">
      Free to install. Works on iOS, Android, and any machine you'd actually code on.
    </p>
    <div class="cta-actions reveal reveal-delay-2">
      <a href="#get-started" class="btn-primary">
        Get started
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 5l7 7-7 7"></path>
        </svg>
      </a>
      <a href="/docs" class="btn-secondary">Read the docs</a>
    </div>
  </div>
</section>

<footer>
  <div class="footer-inner">
    <div class="footer-brand-col">
      <a class="footer-brand" href="/" aria-label="Shellular home">
        <ShellularLogo size={28} context="dark" />
        Shellular
      </a>
      <p class="footer-tagline">Your full dev environment — agents, terminal, files, ports — in your pocket.</p>
      <div class="footer-social">
        {
          social.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer">
              {s.label}
            </a>
          ))
        }
      </div>
    </div>

    <div class="footer-cols">
      {
        columns.map((col) => (
          <div class="footer-col">
            <span class="footer-heading">{col.heading}</span>
            {col.links.map((link) => (
              <a href={link.href} {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                {link.label}
              </a>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div class="footer-base">
    <span>© 2026 Shellular. All rights reserved.</span>
    <span class="footer-base-tag">Made for developers on the move</span>
  </div>
</footer>

<style>
  .cta-banner {
    position: relative;
    background: linear-gradient(180deg, var(--sky-100) 0%, var(--sky-300) 100%);
    padding: clamp(80px, 12vw, 140px) clamp(16px, 6vw, 64px);
    text-align: center;
    overflow: hidden;
  }

  .cta-clouds {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cta-cloud {
    position: absolute;
    width: 240px;
    height: 96px;
  }

  .cta-cloud-1 { top: 18%; left: 6%; }
  .cta-cloud-2 { top: 12%; right: 8%; width: 200px; }

  .cta-inner {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
  }

  .cta-title {
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-size: clamp(2rem, 5vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--ink-900);
    text-wrap: balance;
    margin-bottom: 18px;
  }

  .cta-title span {
    display: block;
    font-style: italic;
    font-weight: 500;
    color: var(--brand-gold-deep);
  }

  .cta-sub {
    font-size: 16px;
    color: var(--ink-700);
    line-height: 1.55;
    margin: 0 auto 28px;
    max-width: 50ch;
  }

  .cta-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  footer {
    background: var(--ink-900);
    color: var(--cream-100);
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(56px, 7vw, 80px) clamp(16px, 6vw, 64px) 40px;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 2fr);
    gap: clamp(32px, 6vw, 80px);
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    background: linear-gradient(135deg, #f0e3c5 0%, var(--brand-gold) 60%, #b59c72 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-weight: 800;
    font-size: 19px;
    letter-spacing: -0.02em;
  }

  .footer-tagline {
    margin: 16px 0 20px;
    font-size: 14px;
    color: rgba(245, 241, 232, 0.6);
    line-height: 1.6;
    max-width: 36ch;
  }

  .footer-social {
    display: flex;
    gap: 16px;
  }

  .footer-social a {
    font-size: 13px;
    font-weight: 600;
    color: rgba(245, 241, 232, 0.7);
    text-decoration: none;
    transition: color 0.18s;
  }

  .footer-social a:hover {
    color: var(--cream-100);
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-heading {
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.45);
    margin-bottom: 4px;
  }

  .footer-col a {
    font-size: 14px;
    color: rgba(245, 241, 232, 0.78);
    text-decoration: none;
    transition: color 0.18s;
  }

  .footer-col a:hover {
    color: var(--cream-100);
  }

  .footer-base {
    max-width: 1200px;
    margin: 0 auto;
    padding: 22px clamp(16px, 6vw, 64px);
    border-top: 1px solid rgba(245, 241, 232, 0.1);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 12.5px;
    color: rgba(245, 241, 232, 0.45);
    position: relative;
  }

  /* Gold hairline accent on the divider */
  .footer-base::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    width: clamp(80px, 12vw, 160px);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--brand-gold), transparent);
    opacity: 0.55;
  }

  .footer-base-tag {
    color: rgba(245, 241, 232, 0.35);
  }

  @media (max-width: 760px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 520px) {
    .footer-cols {
      grid-template-columns: 1fr 1fr;
      gap: 28px 20px;
    }

    .footer-base {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
