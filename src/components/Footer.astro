---
import ShellularLogo from "./ShellularLogo.astro";
import { ENTERPRISE_CALENDAR_URL } from "@/data/appLinks";

const columns = [
  {
    heading: "Product",
    links: [
      { label: "Features", href: "/#features" },
      { label: "Security", href: "/#security" },
      { label: "Docs", href: "/docs" },
      { label: "Enterprise", href: ENTERPRISE_CALENDAR_URL, external: true },
    ],
  },
  {
    heading: "Compare",
    links: [
      { label: "vs Claude Remote Control", href: "/shellular-vs-claude-remote-control" },
      { label: "vs Codex Mobile", href: "/shellular-vs-codex-mobile" },
    ],
  },
  {
    heading: "Company",
    links: [
      { label: "About", href: "/about" },
      { label: "Contact", href: "/contact" },
      { label: "Privacy", href: "/privacy" },
      { label: "Terms", href: "/terms" },
    ],
  },
];

const social = [
  { label: "GitHub", href: "https://github.com/shellular-org" },
  { label: "X", href: "https://x.com/shellular_dev" },
  { label: "LinkedIn", href: "https://www.linkedin.com/company/120924584/admin/dashboard/" },
];
---

<footer>
  <div class="footer-inner">
    <div class="footer-brand-col">
      <a class="footer-brand" href="/" aria-label="Shellular home">
        <span class="footer-mark"><ShellularLogo size={32} /></span>
        Shellular
      </a>
      <p class="footer-tagline">Your full dev environment — agents, terminal, files, ports — in your pocket.</p>
      <div class="footer-social">
        {
          social.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer">
              {s.label}
            </a>
          ))
        }
      </div>
    </div>

    <div class="footer-cols">
      {
        columns.map((col) => (
          <div class="footer-col">
            <span class="footer-heading">{col.heading}</span>
            {col.links.map((link) => (
              <a href={link.href} {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                {link.label}
              </a>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div class="footer-base">
    <span>© 2026 Shellular. All rights reserved.</span>
    <span class="footer-base-tag">Made for developers on the move</span>
  </div>
</footer>

<style>
  footer {
    background: var(--bg-tint);
    border-top: 1px solid var(--border);
  }

  .footer-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: clamp(48px, 7vw, 72px) clamp(16px, 6vw, 64px) 40px;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 2fr);
    gap: clamp(32px, 6vw, 80px);
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 800;
    font-size: 18px;
    letter-spacing: -0.02em;
  }

  .footer-mark {
    display: grid;
    place-items: center;
  }

  .footer-mark svg {
    width: 20px;
    height: 20px;
  }

  .footer-tagline {
    margin: 16px 0 18px;
    font-size: 14px;
    color: var(--grad-accent);
    line-height: 1.6;
    max-width: 34ch;
  }

  .footer-social {
    display: flex;
    gap: 18px;
  }

  .footer-social a {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.18s;
  }

  .footer-social a:hover {
    color: var(--accent);
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-heading {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 4px;
  }

  .footer-col a {
    font-size: 14px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.18s;
  }

  .footer-col a:hover {
    color: var(--accent);
  }

  .footer-base {
    max-width: 1120px;
    margin: 0 auto;
    padding: 22px clamp(16px, 6vw, 64px);
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 12.5px;
    color: var(--text-muted);
  }

  .footer-base-tag {
    color: var(--text-subtle);
  }

  @media (max-width: 760px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 520px) {
    .footer-cols {
      grid-template-columns: 1fr 1fr;
      gap: 28px 20px;
    }

    .footer-base {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
