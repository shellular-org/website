---
import ShellularLogo from "./ShellularLogo.astro";
import { ENTERPRISE_CALENDAR_URL } from "@/data/appLinks";
---

<footer>
  <a class="footer-brand" href="/" aria-label="Shellular home">
    <ShellularLogo size={22} />
    Shellular
  </a>

  <nav class="footer-links" aria-label="Footer links">
    <a href={ENTERPRISE_CALENDAR_URL} target="_blank" rel="noopener noreferrer">Enterprise</a>
    <a href="https://github.com/shellular-org" target="_blank" rel="noopener noreferrer">GitHub</a>
    <a href="https://x.com/shellular_dev" target="_blank" rel="noopener noreferrer">X</a>
    <a href="https://www.linkedin.com/company/120924584/admin/dashboard/" target="_blank" rel="noopener noreferrer"
      >LinkedIn</a
    >
    <a href="/docs">Docs</a>
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
    <a href="/privacy">Privacy</a>
    <a href="/terms">Terms</a>
    <a href="/shellular-vs-claude-remote-control">vs Claude Remote Control</a>
    <a href="/shellular-vs-codex-mobile">vs Codex Mobile</a>
  </nav>

  <span>© 2026 Shellular</span>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line-soft);
    padding: 32px clamp(16px, 8vw, 80px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    color: rgba(180, 170, 154, 0.44);
    font-size: 12px;
  }

  footer :global(a) {
    color: rgba(208, 197, 179, 0.62);
    text-decoration: none;
    transition: color 0.2s;
  }

  footer :global(a:hover) {
    color: var(--accent);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    color: rgba(180, 170, 154, 0.44);
  }

  .footer-links {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }

  @media (max-width: 600px) {
    footer {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .footer-links {
      justify-content: center;
    }
  }
</style>
