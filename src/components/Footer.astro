---
import { GithubIcon, LinkedinIcon, XIcon } from "./icons";
import ShellularLogo from "./ShellularLogo.astro";

const socialIcon = {
  github: GithubIcon,
  x: XIcon,
  linkedin: LinkedinIcon,
} as const;

const columns = [
  {
    heading: "Product",
    links: [
      { label: "Features", href: "/#features" },
      { label: "Security", href: "/#security" },
      { label: "Docs", href: "/docs" },
      { label: "Blog", href: "/blog" },
      { label: "Enterprise", href: "/enterprise" },
    ],
  },
  {
    heading: "Compare",
    links: [
      {
        label: "vs Claude Remote Control",
        href: "/shellular-vs-claude-remote-control",
      },
      { label: "vs Codex Mobile", href: "/shellular-vs-codex-mobile" },
    ],
  },
  {
    heading: "Company",
    links: [
      { label: "About", href: "/about" },
      { label: "Contact", href: "/contact" },
      { label: "Privacy", href: "/privacy" },
      { label: "Terms", href: "/terms" },
    ],
  },
];

const social: { label: string; href: string; Icon: (typeof socialIcon)[keyof typeof socialIcon] }[] = [
  { label: "GitHub", href: "https://github.com/shellular-org", Icon: GithubIcon },
  { label: "X", href: "https://x.com/shellular_dev", Icon: XIcon },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/company/120924584/admin/dashboard/",
    Icon: LinkedinIcon,
  },
];
---

<footer>
  <!-- Decorative ambient layer: faint starfield + horizon glow -->
  <div class="footer-bg" aria-hidden="true">
    <div class="footer-glow"></div>
    <svg class="footer-stars" viewBox="0 0 1200 240" preserveAspectRatio="none">
      <g fill="rgba(214, 194, 161, 0.55)">
        <circle cx="80" cy="40" r="0.7"></circle>
        <circle cx="220" cy="90" r="1"></circle>
        <circle cx="340" cy="30" r="0.6"></circle>
        <circle cx="480" cy="120" r="0.8"></circle>
        <circle cx="620" cy="50" r="1.1"></circle>
        <circle cx="760" cy="100" r="0.6"></circle>
        <circle cx="880" cy="38" r="0.9"></circle>
        <circle cx="1020" cy="110" r="0.7"></circle>
        <circle cx="1140" cy="60" r="0.8"></circle>
        <circle cx="160" cy="170" r="0.6"></circle>
        <circle cx="400" cy="200" r="0.5"></circle>
        <circle cx="700" cy="180" r="0.7"></circle>
        <circle cx="980" cy="210" r="0.6"></circle>
      </g>
    </svg>
  </div>

  <div class="footer-inner">
    <div class="footer-brand-col">
      <a class="footer-brand" href="/" aria-label="Shellular home">
        <ShellularLogo size={32} context="dark" />
        <span class="footer-brand-text">Shellular</span>
      </a>
      <p class="footer-tagline">Your full dev environment — agents, terminal, files, ports — in your pocket.</p>
      <p class="footer-proof">
        Built by the team behind <a href="https://acode.app" target="_blank" rel="noopener noreferrer">Acode</a>.
      </p>

      <div class="footer-social" aria-label="Shellular on social">
        {
          social.map(({ label, href, Icon }) => {
            return (
              <a class="footer-social-btn" href={href} target="_blank" rel="noopener noreferrer" aria-label={label}>
                <Icon size={16} />
              </a>
            );
          })
        }
      </div>
    </div>

    <div class="footer-cols">
      {
        columns.map((col) => (
          <div class="footer-col">
            <span class="footer-heading">{col.heading}</span>
            {col.links.map((link) => (
              <a href={link.href} {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                {link.label}
              </a>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div class="footer-base">
    <span class="footer-base-copy">© 2026 Shellular — all rights reserved.</span>
    <span class="footer-base-tag">Made for developers on the move.</span>
  </div>

  <!-- Big watermark wordmark -->
  <div class="footer-watermark" aria-hidden="true">SHELLULAR</div>
</footer>

<style>
  /* ── Footer container ────────────────────────────────────── */
  footer {
    position: relative;
    background: linear-gradient(180deg, #1a1615 0%, #0f0c0b 100%);
    color: var(--cream-100);
    overflow: hidden;
    isolation: isolate;
  }

  /* Ambient background: stars + warm gold horizon glow */
  .footer-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .footer-stars {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 240px;
    opacity: 0.85;
  }

  .footer-glow {
    position: absolute;
    left: 50%;
    bottom: -260px;
    transform: translateX(-50%);
    width: 1200px;
    height: 500px;
    background: radial-gradient(
      ellipse at center,
      rgba(214, 194, 161, 0.16) 0%,
      rgba(214, 194, 161, 0.05) 35%,
      transparent 70%
    );
    pointer-events: none;
    filter: blur(2px);
  }

  .footer-inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(72px, 9vw, 110px) clamp(16px, 6vw, 64px) 56px;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 2fr);
    gap: clamp(40px, 6vw, 96px);
  }

  /* ── Brand column ──────────────────────────────────────── */
  .footer-brand-col {
    display: flex;
    flex-direction: column;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    width: fit-content;
  }

  .footer-brand-text {
    background: linear-gradient(135deg, #f0e3c5 0%, var(--brand-gold) 60%, #b59c72 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.025em;
  }

  .footer-tagline {
    margin: 18px 0 10px;
    font-size: 14px;
    color: rgba(245, 241, 232, 0.62);
    line-height: 1.65;
    max-width: 36ch;
  }

  .footer-proof {
    margin: 0 0 24px;
    font-size: 13px;
    color: rgba(245, 241, 232, 0.42);
    line-height: 1.55;
    max-width: 36ch;
  }

  .footer-proof a {
    color: rgba(245, 241, 232, 0.68);
    text-decoration-color: rgba(214, 194, 161, 0.28);
    text-underline-offset: 3px;
    transition:
      color 0.18s ease,
      text-decoration-color 0.18s ease;
  }

  .footer-proof a:hover {
    color: var(--cream-100);
    text-decoration-color: var(--brand-gold);
  }

  @keyframes footer-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 3px rgba(14, 161, 88, 0.2);
    }
    50% {
      box-shadow: 0 0 0 6px rgba(14, 161, 88, 0.06);
    }
  }

  /* ── Social ────────────────────────────────────────────── */
  .footer-social {
    display: flex;
    gap: 10px;
  }

  .footer-social-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: inline-grid;
    place-items: center;
    background: rgba(245, 241, 232, 0.04);
    border: 1px solid rgba(245, 241, 232, 0.1);
    color: rgba(245, 241, 232, 0.65);
    transition:
      color 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .footer-social-btn svg {
    display: block;
  }

  .footer-social-btn:hover {
    color: var(--cream-100);
    background: rgba(245, 241, 232, 0.08);
    border-color: rgba(245, 241, 232, 0.22);
    transform: translateY(-1px);
  }

  /* ── Link columns ──────────────────────────────────────── */
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-heading {
    font-family: "Fragment Mono", "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-gold);
    margin-bottom: 6px;
    opacity: 0.75;
  }

  .footer-col a {
    position: relative;
    font-size: 14px;
    color: rgba(245, 241, 232, 0.7);
    text-decoration: none;
    transition:
      color 0.18s ease,
      padding-left 0.2s ease;
    width: fit-content;
  }

  .footer-col a::before {
    content: "";
    position: absolute;
    left: -14px;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 1px;
    background: var(--brand-gold);
    opacity: 0;
    transition:
      opacity 0.2s ease,
      width 0.2s ease;
  }

  .footer-col a:hover {
    color: var(--cream-100);
    padding-left: 12px;
  }

  .footer-col a:hover::before {
    opacity: 1;
    width: 8px;
  }

  @keyframes footer-blink {
    50% {
      opacity: 0;
    }
  }

  /* ── Base copyright ────────────────────────────────────── */
  .footer-base {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 22px clamp(16px, 6vw, 64px) 28px;
    border-top: 1px solid rgba(245, 241, 232, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 12.5px;
    color: rgba(245, 241, 232, 0.42);
  }

  /* Gold hairline at center of divider */
  .footer-base::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    width: clamp(80px, 12vw, 160px);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--brand-gold), transparent);
    opacity: 0.5;
  }

  .footer-base-copy {
    font-family: "Fragment Mono", "JetBrains Mono", monospace;
    letter-spacing: 0.01em;
  }
  .footer-base-tag {
    color: rgba(245, 241, 232, 0.32);
    font-style: italic;
  }

  /* ── Big watermark ─────────────────────────────────────── */
  .footer-watermark {
    position: absolute;
    left: 50%;
    bottom: -22px;
    transform: translateX(-50%);
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-weight: 900;
    font-size: clamp(110px, 22vw, 280px);
    letter-spacing: -0.06em;
    line-height: 0.85;
    pointer-events: none;
    user-select: none;
    background: linear-gradient(180deg, rgba(214, 194, 161, 0.07) 0%, rgba(214, 194, 161, 0.025) 60%, transparent 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    z-index: 0;
    white-space: nowrap;
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 760px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .footer-watermark {
      font-size: clamp(80px, 26vw, 160px);
      bottom: -12px;
    }
  }

  @media (max-width: 520px) {
    .footer-cols {
      grid-template-columns: 1fr 1fr;
      gap: 28px 20px;
    }

    .footer-base {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-cmd {
      font-size: 11.5px;
      padding: 8px 12px;
    }
  }
</style>
