---
import ShellularLogo from "./ShellularLogo.astro";
import { ENTERPRISE_CALENDAR_URL } from "@/data/appLinks";
import githubIcon from "@/assets/social/github.svg";
import xIcon from "@/assets/social/x.svg";
import linkedinIcon from "@/assets/social/linkedin.svg";

const columns = [
  {
    heading: "Product",
    links: [
      { label: "Features", href: "/#features" },
      { label: "Security", href: "/#security" },
      { label: "Docs", href: "/docs" },
      { label: "Enterprise", href: ENTERPRISE_CALENDAR_URL, external: true },
    ],
  },
  {
    heading: "Compare",
    links: [
      { label: "vs Claude Remote Control", href: "/shellular-vs-claude-remote-control" },
      { label: "vs Codex Mobile", href: "/shellular-vs-codex-mobile" },
    ],
  },
  {
    heading: "Company",
    links: [
      { label: "About", href: "/about" },
      { label: "Contact", href: "/contact" },
      { label: "Privacy", href: "/privacy" },
      { label: "Terms", href: "/terms" },
    ],
  },
];

const social = [
  { label: "GitHub",   href: "https://github.com/shellular-org",                            icon: githubIcon.src   },
  { label: "X",        href: "https://x.com/shellular_dev",                                 icon: xIcon.src        },
  { label: "LinkedIn", href: "https://www.linkedin.com/company/120924584/admin/dashboard/", icon: linkedinIcon.src },
];
---

<!-- Final CTA banner -->
<section class="cta-banner">
  <div class="cta-clouds" aria-hidden="true">
    <svg class="cta-cloud cta-cloud-1" viewBox="0 0 200 80">
      <path
        d="M40 60 Q20 60 20 45 Q20 30 38 30 Q44 14 64 16 Q82 14 92 30 Q108 26 118 38 Q138 36 144 52 Q150 64 138 68 L52 68 Q40 68 40 60 Z"
        fill="#ffffff"
        opacity="0.85"></path>
    </svg>
    <svg class="cta-cloud cta-cloud-2" viewBox="0 0 200 80">
      <path
        d="M40 60 Q20 60 20 45 Q20 30 38 30 Q44 14 64 16 Q82 14 92 30 Q108 26 118 38 Q138 36 144 52 Q150 64 138 68 L52 68 Q40 68 40 60 Z"
        fill="#ffffff"
        opacity="0.7"></path>
    </svg>
  </div>
  <div class="cta-inner">
    <h2 class="cta-title reveal">
      Ready to take your stack
      <span>with you?</span>
    </h2>
    <p class="cta-sub reveal reveal-delay-1">
      Free to install. Works on iOS, Android, and any machine you'd actually code on.
    </p>
    <div class="cta-actions reveal reveal-delay-2">
      <a href="#get-started" class="btn-primary">
        Get started
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 5l7 7-7 7"></path>
        </svg>
      </a>
      <a href="/docs" class="btn-secondary">Read the docs</a>
    </div>
  </div>
</section>

<footer>
  <!-- Decorative ambient layer: faint starfield + horizon glow -->
  <div class="footer-bg" aria-hidden="true">
    <div class="footer-glow"></div>
    <svg class="footer-stars" viewBox="0 0 1200 240" preserveAspectRatio="none">
      <g fill="rgba(214, 194, 161, 0.55)">
        <circle cx="80" cy="40" r="0.7"></circle>
        <circle cx="220" cy="90" r="1"></circle>
        <circle cx="340" cy="30" r="0.6"></circle>
        <circle cx="480" cy="120" r="0.8"></circle>
        <circle cx="620" cy="50" r="1.1"></circle>
        <circle cx="760" cy="100" r="0.6"></circle>
        <circle cx="880" cy="38" r="0.9"></circle>
        <circle cx="1020" cy="110" r="0.7"></circle>
        <circle cx="1140" cy="60" r="0.8"></circle>
        <circle cx="160" cy="170" r="0.6"></circle>
        <circle cx="400" cy="200" r="0.5"></circle>
        <circle cx="700" cy="180" r="0.7"></circle>
        <circle cx="980" cy="210" r="0.6"></circle>
      </g>
    </svg>
  </div>

  <div class="footer-inner">
    <div class="footer-brand-col">
      <a class="footer-brand" href="/" aria-label="Shellular home">
        <ShellularLogo size={32} context="dark" />
        <span class="footer-brand-text">Shellular</span>
      </a>
      <p class="footer-tagline">Your full dev environment — agents, terminal, files, ports — in your pocket.</p>

      <div class="footer-social" aria-label="Shellular on social">
        {
          social.map(({ label, href, icon }) => (
            <a class="footer-social-btn" href={href} target="_blank" rel="noopener noreferrer" aria-label={label}>
              <img src={icon} alt="" width="16" height="16" aria-hidden="true" />
            </a>
          ))
        }
      </div>
    </div>

    <div class="footer-cols">
      {
        columns.map((col) => (
          <div class="footer-col">
            <span class="footer-heading">{col.heading}</span>
            {col.links.map((link) => (
              <a href={link.href} {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                {link.label}
              </a>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- Terminal signoff -->
  <div class="footer-cmd-row">
    <div class="footer-cmd">
      <span class="footer-cmd-prompt">~</span>
      <span class="footer-cmd-arrow">›</span>
      <span class="footer-cmd-text">shellular --made-with care</span>
      <span class="footer-cmd-cursor" aria-hidden="true"></span>
    </div>
  </div>

  <div class="footer-base">
    <span class="footer-base-copy">© 2026 Shellular — all rights reserved.</span>
    <span class="footer-base-tag">Made for developers on the move.</span>
  </div>

  <!-- Big watermark wordmark -->
  <div class="footer-watermark" aria-hidden="true">SHELLULAR</div>
</footer>

<style>
  .cta-banner {
    position: relative;
    background: linear-gradient(180deg, var(--sky-100) 0%, var(--sky-300) 100%);
    padding: clamp(80px, 12vw, 140px) clamp(16px, 6vw, 64px);
    text-align: center;
    overflow: hidden;
  }

  .cta-clouds {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .cta-cloud {
    position: absolute;
    width: 240px;
    height: 96px;
  }
  .cta-cloud-1 {
    top: 18%;
    left: 6%;
  }
  .cta-cloud-2 {
    top: 12%;
    right: 8%;
    width: 200px;
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
  }

  .cta-title {
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-size: clamp(2rem, 5vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--ink-900);
    text-wrap: balance;
    margin-bottom: 18px;
  }

  .cta-title span {
    display: block;
    font-style: italic;
    font-weight: 500;
    color: var(--brand-gold-deep);
  }

  .cta-sub {
    font-size: 16px;
    color: var(--ink-700);
    line-height: 1.55;
    margin: 0 auto 28px;
    max-width: 50ch;
  }

  .cta-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Footer container ────────────────────────────────────── */
  footer {
    position: relative;
    background: linear-gradient(180deg, #1a1615 0%, #0f0c0b 100%);
    color: var(--cream-100);
    overflow: hidden;
    isolation: isolate;
  }

  /* Ambient background: stars + warm gold horizon glow */
  .footer-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .footer-stars {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 240px;
    opacity: 0.85;
  }

  .footer-glow {
    position: absolute;
    left: 50%;
    bottom: -260px;
    transform: translateX(-50%);
    width: 1200px;
    height: 500px;
    background: radial-gradient(
      ellipse at center,
      rgba(214, 194, 161, 0.16) 0%,
      rgba(214, 194, 161, 0.05) 35%,
      transparent 70%
    );
    pointer-events: none;
    filter: blur(2px);
  }

  .footer-inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(72px, 9vw, 110px) clamp(16px, 6vw, 64px) 56px;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 2fr);
    gap: clamp(40px, 6vw, 96px);
  }

  /* ── Brand column ──────────────────────────────────────── */
  .footer-brand-col {
    display: flex;
    flex-direction: column;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    width: fit-content;
  }

  .footer-brand-text {
    background: linear-gradient(135deg, #f0e3c5 0%, var(--brand-gold) 60%, #b59c72 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.025em;
  }

  .footer-tagline {
    margin: 18px 0 24px;
    font-size: 14px;
    color: rgba(245, 241, 232, 0.62);
    line-height: 1.65;
    max-width: 36ch;
  }

  @keyframes footer-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 3px rgba(14, 161, 88, 0.2);
    }
    50% {
      box-shadow: 0 0 0 6px rgba(14, 161, 88, 0.06);
    }
  }

  /* ── Social ────────────────────────────────────────────── */
  .footer-social {
    display: flex;
    gap: 10px;
  }

  .footer-social-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: inline-grid;
    place-items: center;
    background: rgba(245, 241, 232, 0.04);
    border: 1px solid rgba(245, 241, 232, 0.1);
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .footer-social-btn img {
    display: block;
    width: 16px;
    height: 16px;
    opacity: 0.65;
    transition: opacity 0.2s ease;
  }

  .footer-social-btn:hover {
    background: rgba(245, 241, 232, 0.08);
    border-color: rgba(245, 241, 232, 0.22);
    transform: translateY(-1px);
  }

  .footer-social-btn:hover img {
    opacity: 1;
  }

  /* ── Link columns ──────────────────────────────────────── */
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-heading {
    font-family: "Fragment Mono", "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-gold);
    margin-bottom: 6px;
    opacity: 0.75;
  }

  .footer-col a {
    position: relative;
    font-size: 14px;
    color: rgba(245, 241, 232, 0.7);
    text-decoration: none;
    transition:
      color 0.18s ease,
      padding-left 0.2s ease;
    width: fit-content;
  }

  .footer-col a::before {
    content: "";
    position: absolute;
    left: -14px;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 1px;
    background: var(--brand-gold);
    opacity: 0;
    transition:
      opacity 0.2s ease,
      width 0.2s ease;
  }

  .footer-col a:hover {
    color: var(--cream-100);
    padding-left: 12px;
  }

  .footer-col a:hover::before {
    opacity: 1;
    width: 8px;
  }

  /* ── Terminal command signoff ──────────────────────────── */
  .footer-cmd-row {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(16px, 6vw, 64px) 20px;
  }

  .footer-cmd {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    background: rgba(245, 241, 232, 0.04);
    border: 1px solid rgba(245, 241, 232, 0.08);
    border-radius: 10px;
    font-family: "Fragment Mono", "JetBrains Mono", monospace;
    font-size: 12.5px;
  }

  .footer-cmd-prompt {
    color: var(--brand-gold);
    font-weight: 600;
  }
  .footer-cmd-arrow {
    color: var(--accent-orange);
    font-weight: 700;
  }
  .footer-cmd-text {
    color: rgba(245, 241, 232, 0.78);
  }

  .footer-cmd-cursor {
    display: inline-block;
    width: 7px;
    height: 13px;
    background: var(--brand-gold);
    margin-left: 2px;
    animation: footer-blink 1.1s steps(2) infinite;
    vertical-align: middle;
  }

  @keyframes footer-blink {
    50% {
      opacity: 0;
    }
  }

  /* ── Base copyright ────────────────────────────────────── */
  .footer-base {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 22px clamp(16px, 6vw, 64px) 28px;
    border-top: 1px solid rgba(245, 241, 232, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 12.5px;
    color: rgba(245, 241, 232, 0.42);
  }

  /* Gold hairline at center of divider */
  .footer-base::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    width: clamp(80px, 12vw, 160px);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--brand-gold), transparent);
    opacity: 0.5;
  }

  .footer-base-copy {
    font-family: "Fragment Mono", "JetBrains Mono", monospace;
    letter-spacing: 0.01em;
  }
  .footer-base-tag {
    color: rgba(245, 241, 232, 0.32);
    font-style: italic;
  }

  /* ── Big watermark ─────────────────────────────────────── */
  .footer-watermark {
    position: absolute;
    left: 50%;
    bottom: -22px;
    transform: translateX(-50%);
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-weight: 900;
    font-size: clamp(110px, 22vw, 280px);
    letter-spacing: -0.06em;
    line-height: 0.85;
    pointer-events: none;
    user-select: none;
    background: linear-gradient(180deg, rgba(214, 194, 161, 0.07) 0%, rgba(214, 194, 161, 0.025) 60%, transparent 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    z-index: 0;
    white-space: nowrap;
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 760px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .footer-watermark {
      font-size: clamp(80px, 26vw, 160px);
      bottom: -12px;
    }
  }

  @media (max-width: 520px) {
    .footer-cols {
      grid-template-columns: 1fr 1fr;
      gap: 28px 20px;
    }

    .footer-base {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-cmd {
      font-size: 11.5px;
      padding: 8px 12px;
    }
  }
</style>
