---
import Footer from "@/components/Footer.astro";
import Nav from "@/components/Nav.astro";
import Layout from "@/layouts/Layout.astro";

interface Faq {
	q: string;
	a: string;
}

interface RelatedLink {
	href: string;
	label: string;
	note: string;
}

interface Props {
	title: string;
	description: string;
	keywords?: string[];
	heading: string;
	tagline: string;
	dateLabel: string;
	dateISO: string;
	readTime: string;
	slug: string;
	pills?: string[];
	faqs?: Faq[];
	related?: RelatedLink[];
}

const {
	title,
	description,
	keywords = [],
	heading,
	tagline,
	dateLabel,
	dateISO,
	readTime,
	slug,
	pills = [],
	faqs = [],
	related = [],
} = Astro.props;

const url = `https://shellular.dev/blog/${slug}`;

const structuredData = [
	{
		"@context": "https://schema.org",
		"@type": "Article",
		headline: heading,
		description,
		datePublished: dateISO,
		dateModified: dateISO,
		author: {
			"@type": "Organization",
			name: "Shellular",
			url: "https://shellular.dev",
		},
		publisher: {
			"@type": "Organization",
			name: "Shellular",
			url: "https://shellular.dev",
		},
		mainEntityOfPage: url,
		url,
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: "Home",
				item: "https://shellular.dev",
			},
			{
				"@type": "ListItem",
				position: 2,
				name: "Blog",
				item: "https://shellular.dev/blog",
			},
			{
				"@type": "ListItem",
				position: 3,
				name: heading,
				item: url,
			},
		],
	},
	...(faqs.length > 0
		? [
				{
					"@context": "https://schema.org",
					"@type": "FAQPage",
					mainEntity: faqs.map((f) => ({
						"@type": "Question",
						name: f.q,
						acceptedAnswer: {
							"@type": "Answer",
							text: f.a,
						},
					})),
				},
			]
		: []),
];
---

<Layout title={title} description={description} keywords={keywords} ogType="article" structuredData={structuredData}>
  <Nav currentPath={Astro.url.pathname} />

  <main class="article-page">
    <article class="article-shell">
      <header class="article-hero">
        <a class="back-link" href="/blog">← All articles</a>
        <h1>{heading}</h1>
        <p class="article-tagline">{tagline}</p>
        <div class="article-meta">
          <time datetime={dateISO}>{dateLabel}</time>
          <span class="dot" aria-hidden="true">•</span>
          <span>{readTime}</span>
        </div>
        {
          pills.length > 0 && (
            <div class="article-pills">
              {pills.map((p) => <span>{p}</span>)}
            </div>
          )
        }
      </header>

      <div class="article-body">
        <slot />
      </div>

      {
        faqs.length > 0 && (
          <section class="article-faq" aria-labelledby="faq-heading">
            <h2 id="faq-heading">Frequently asked questions</h2>
            <div class="faq-list">
              {faqs.map((f) => (
                <details class="faq-item">
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </div>
          </section>
        )
      }

      {
        related.length > 0 && (
          <section class="article-related" aria-labelledby="related-heading">
            <h2 id="related-heading">Keep reading</h2>
            <div class="related-list">
              {related.map((r) => (
                <a class="related-card" href={r.href}>
                  <span class="related-label">{r.label}</span>
                  <span class="related-note">{r.note}</span>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <aside class="article-cta">
        <h2>Try it for yourself</h2>
        <p>Shellular puts a real terminal, your files, Git, and every AI agent you run on your phone. Pair once with a QR code and you are coding from anywhere.</p>
        <div class="cta-row">
          <a class="cta-link" href="/#get-started">Get Shellular</a>
          <a class="cta-ghost" href="/docs">Read the docs</a>
        </div>
      </aside>
    </article>
  </main>

  <Footer />
</Layout>

<style>
  .article-page {
    padding-top: 60px;
    background: var(--cream-100);
  }

  .article-shell {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(40px, 7vw, 84px) clamp(20px, 5vw, 48px) clamp(64px, 9vw, 110px);
  }

  /* ── Hero ──────────────────────────────────────────────── */
  .article-hero {
    border-bottom: 1px solid var(--line-soft);
    padding-bottom: 28px;
    margin-bottom: 36px;
  }

  .back-link {
    display: inline-block;
    font-family: "Fragment Mono", "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-gold-deep);
    text-decoration: none;
    margin-bottom: 22px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--ink-900);
  }

  .article-hero h1 {
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-size: clamp(2rem, 5vw, 3.1rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--ink-900);
    margin-bottom: 16px;
    text-wrap: balance;
  }

  .article-tagline {
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink-700);
    max-width: 62ch;
  }

  .article-meta {
    margin-top: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .article-meta .dot {
    opacity: 0.5;
  }

  .article-pills {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .article-pills span {
    font-size: 12px;
    font-weight: 600;
    color: var(--brand-gold-ink);
    background: rgba(var(--brand-gold-rgb), 0.16);
    border: 1px solid rgba(var(--brand-gold-rgb), 0.34);
    padding: 6px 13px;
    border-radius: var(--radius-pill);
    letter-spacing: 0.02em;
  }

  /* ── Body ──────────────────────────────────────────────── */
  .article-body :global(h2) {
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink-900);
    margin: 44px 0 16px;
    line-height: 1.15;
  }

  .article-body :global(h3) {
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-size: 1.12rem;
    font-weight: 700;
    color: var(--ink-900);
    margin: 30px 0 12px;
  }

  .article-body :global(p) {
    font-size: 16px;
    line-height: 1.8;
    color: var(--ink-700);
    margin-bottom: 18px;
  }

  .article-body :global(a:not(.cta-link):not(.cta-ghost)) {
    color: var(--accent-blue);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
    transition: color 0.2s;
  }

  .article-body :global(a:not(.cta-link):not(.cta-ghost):hover) {
    color: var(--accent-orange);
  }

  .article-body :global(strong) {
    color: var(--ink-900);
    font-weight: 700;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 20px;
    padding-left: 22px;
  }

  .article-body :global(li) {
    font-size: 16px;
    line-height: 1.75;
    color: var(--ink-700);
    margin-bottom: 8px;
  }

  .article-body :global(li::marker) {
    color: var(--brand-gold-deep);
  }

  .article-body :global(blockquote) {
    margin: 24px 0;
    padding: 16px 22px;
    border-left: 3px solid var(--brand-gold);
    background: rgba(var(--brand-gold-rgb), 0.1);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    color: var(--ink-700);
    font-size: 15px;
    line-height: 1.7;
  }

  .article-body :global(blockquote p) {
    margin: 0;
  }

  .article-body :global(code) {
    font-family: "Fragment Mono", "JetBrains Mono", monospace;
    font-size: 0.88em;
    background: rgba(26, 22, 21, 0.06);
    border: 1px solid rgba(26, 22, 21, 0.08);
    padding: 2px 6px;
    border-radius: 6px;
    color: var(--ink-900);
  }

  .article-body :global(pre) {
    background: var(--ink-900);
    color: var(--cream-100);
    padding: 18px 20px;
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: 0 0 22px;
    font-size: 13.5px;
    line-height: 1.65;
  }

  .article-body :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }

  /* ── FAQ ───────────────────────────────────────────────── */
  .article-faq {
    margin-top: 56px;
    padding-top: 36px;
    border-top: 1px solid var(--line-soft);
  }

  .article-faq h2,
  .article-related h2 {
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink-900);
    margin-bottom: 20px;
    line-height: 1.15;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .faq-item {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: border-color 0.22s ease;
  }

  .faq-item[open] {
    border-color: rgba(var(--brand-gold-rgb), 0.45);
  }

  .faq-item summary {
    cursor: pointer;
    list-style: none;
    padding: 16px 20px;
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-size: 15.5px;
    font-weight: 700;
    color: var(--ink-900);
    letter-spacing: -0.01em;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: "+";
    font-family: "Fragment Mono", "JetBrains Mono", monospace;
    font-size: 18px;
    font-weight: 400;
    color: var(--brand-gold-deep);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq-item p {
    padding: 0 20px 18px;
    margin: 0;
    font-size: 15px;
    line-height: 1.75;
    color: var(--ink-700);
  }

  /* ── Related ───────────────────────────────────────────── */
  .article-related {
    margin-top: 48px;
    padding-top: 36px;
    border-top: 1px solid var(--line-soft);
  }

  .related-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 16px 18px;
    border-radius: var(--radius-md);
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
  }

  .related-card:hover {
    transform: translateY(-3px);
    border-color: rgba(var(--brand-gold-rgb), 0.45);
    box-shadow: var(--shadow-md);
  }

  .related-label {
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: var(--ink-900);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .related-note {
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .related-list {
      grid-template-columns: 1fr;
    }
  }

  /* ── CTA ───────────────────────────────────────────────── */
  .article-cta {
    margin-top: 56px;
    padding: clamp(28px, 5vw, 40px);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgba(var(--brand-gold-rgb), 0.18), rgba(var(--brand-gold-rgb), 0.06));
    border: 1px solid rgba(var(--brand-gold-rgb), 0.3);
  }

  .article-cta h2 {
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink-900);
    margin-bottom: 10px;
  }

  .article-cta p {
    color: var(--ink-700);
    font-size: 15px;
    line-height: 1.7;
    max-width: 60ch;
    margin-bottom: 22px;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    padding: 12px 22px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    background: var(--ink-900);
    color: var(--cream-100);
    font-size: 14px;
    font-weight: 700;
    transition: transform 0.2s, background 0.2s;
  }

  .cta-link:hover {
    transform: translateY(-2px);
    background: var(--ink-700);
  }

  .cta-ghost {
    display: inline-flex;
    align-items: center;
    padding: 12px 22px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(26, 22, 21, 0.14);
    color: var(--ink-900);
    font-size: 14px;
    font-weight: 700;
    transition: transform 0.2s, background 0.2s;
  }

  .cta-ghost:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.95);
  }
</style>
