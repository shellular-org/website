---
import { APP_STORE_URL, PLAY_STORE_URL } from "@/data/appLinks";

interface Props {
  className?: string;
  show?: "ios" | "android";
}

const { className = "", show } = Astro.props;
const rootClassName = ["app-badges", className].filter(Boolean).join(" ");
---

<div class={rootClassName}>
  {
    (!show || show === "ios") && (
      <a
        href={APP_STORE_URL}
        class="app-badge"
        aria-label="Download on the App Store"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" />
        </svg>
        <div class="badge-text">
          <span class="badge-label">Download on the</span>
          <span class="badge-store">App Store</span>
        </div>
      </a>
    )
  }

  {
    (!show || show === "android") && (
      <a
        href={PLAY_STORE_URL}
        class="app-badge"
        aria-label="Get it on Google Play"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 640 640"
          fill="currentColor"
          width="20"
          height="20"
          aria-hidden="true"
        >
          <path d="M389.6 298.3L168.9 77L449.7 238.2L389.6 298.3zM111.3 64C98.3 70.8 89.6 83.2 89.6 99.3L89.6 540.6C89.6 556.7 98.3 569.1 111.3 575.9L367.9 319.9L111.3 64zM536.5 289.6L477.6 255.5L411.9 320L477.6 384.5L537.7 350.4C555.7 336.1 555.7 303.9 536.5 289.6zM168.9 563L449.7 401.8L389.6 341.7L168.9 563z" />
        </svg>
        <div class="badge-text">
          <span class="badge-label">Get it on</span>
          <span class="badge-store">Google Play</span>
        </div>
      </a>
    )
  }

  <style>
    .app-badges {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .app-badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 10px 18px;
      background-color: var(--ink-900);
      border: 1px solid var(--ink-900);
      border-radius: var(--radius-pill);
      text-decoration: none;
      color: var(--cream-100);
      transition:
        background-color 0.2s,
        transform 0.2s,
        box-shadow 0.2s;
      box-shadow: 0 6px 18px rgba(26, 22, 21, 0.18);
    }

    .app-badge:hover {
      background: var(--ink-700);
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgba(26, 22, 21, 0.24);
    }

    .badge-text {
      display: flex;
      flex-direction: column;
      line-height: 1.2;
    }

    .badge-label {
      font-size: 10px;
      color: rgba(245, 241, 232, 0.7);
      font-weight: 500;
      letter-spacing: 0.02em;
    }

    .badge-store {
      font-size: 14px;
      font-weight: 700;
      color: var(--cream-100);
    }

    @media (max-width: 700px) {
      .app-badges {
        justify-content: center;
      }
    }
  </style>
</div>
