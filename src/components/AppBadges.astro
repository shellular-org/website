---
import AppStoreBadge from "@/components/AppStoreBadge.astro";
import PlayStoreBadge from "@/components/PlayStoreBadge.astro";

interface Props {
	className?: string;
	show?: "ios" | "android";
}

const { className = "", show } = Astro.props;
const rootClassName = ["app-badges", className].filter(Boolean).join(" ");
---

<div class={rootClassName}>
  {(!show || show === "ios") && <AppStoreBadge />}
  {(!show || show === "android") && <PlayStoreBadge />}

  <style>
    .app-badges {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    @media (max-width: 700px) {
      .app-badges {
        justify-content: center;
      }
    }
  </style>
</div>
