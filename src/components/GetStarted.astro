---
import AppStoreBadge from "@/components/AppStoreBadge.astro";
import PlayStoreBadge from "@/components/PlayStoreBadge.astro";

const INSTALL_CMD = "npx shellular";
---

<section id="get-started">
  <div id="how-inner">
    <div class="header">
      <h2 class="section-title reveal reveal-delay-1">
        Up and running
        <span>in under a minute.</span>
      </h2>
      <p class="section-sub reveal reveal-delay-2">
        Install the app, start the host on your machine, and connect to the
        environment you already use.
      </p>
      <a
        class="vps-link reveal reveal-delay-2"
        href="/blog/how-to-set-up-shellular-on-a-vps"
      >
        Running on a VPS instead? Follow this
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="steps">
      <!-- Step 1 -->
      <div class="step reveal">
        <div class="step-header">
          <div class="step-num">1</div>
          <div class="step-title">Install the app</div>
        </div>
        <p class="step-desc">
          Download Shellular on your phone. Available for both iOS and Android
        </p>
        <div class="step-extra">
          <AppStoreBadge />
          <PlayStoreBadge />
        </div>
      </div>

      <!-- Step 2 -->
      <div class="step reveal reveal-delay-1">
        <div class="step-header">
          <div class="step-num">2</div>
          <div class="step-title">Start the host</div>
        </div>
        <p class="step-desc">
          One command on your machine — it connects to the relay and prints a QR
          code.
        </p>
        <div class="code-block">
          <span class="prompt" aria-hidden="true">$</span>
          <span class="cmd-text">{INSTALL_CMD}</span>
          <button
            class="copy-btn"
            id="copy-btn"
            data-cmd={INSTALL_CMD}
            aria-label="Copy command"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="icon-copy"
              aria-hidden="true"
            >
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
              ></path>
            </svg>
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="icon-check"
              aria-hidden="true"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </button>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="step reveal reveal-delay-2">
        <div class="step-header">
          <div class="step-num">3</div>
          <div class="step-title">Scan &amp; ship</div>
        </div>
        <p class="step-desc">
          Scan the QR code, approve the device on the host, and your full dev
          environment is in your pocket.
        </p>
        <div class="flow">
          <span class="flow-step">scan QR</span>
          <span class="flow-arrow" aria-hidden="true">→</span>
          <span class="flow-step">approve</span>
          <span class="flow-arrow" aria-hidden="true">→</span>
          <span class="flow-step flow-step--live">live</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #get-started {
    background: var(--cream-300);
    position: relative;
    overflow: hidden;
  }

  #how-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(80px, 10vw, 120px) clamp(16px, 6vw, 64px);
    position: relative;
    z-index: 1;
  }

  .header {
    text-align: center;
    margin-bottom: 48px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    margin-top: 48px;
    align-items: stretch;
    position: relative;
  }

  /* Faint connector line behind the steps on desktop */
  .steps::before {
    content: "";
    position: absolute;
    top: 46px;
    left: 12%;
    right: 12%;
    height: 2px;
    background: repeating-linear-gradient(
      to right,
      rgba(26, 22, 21, 0.18) 0 4px,
      transparent 4px 10px
    );
    z-index: 0;
    pointer-events: none;
  }

  @media (max-width: 880px) {
    .steps::before {
      display: none;
    }
  }

  .step {
    position: relative;
    z-index: 1;
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 100%;
    padding: 28px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.28s ease,
      box-shadow 0.28s ease;
    position: relative;
  }

  .step:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }

  .step-header {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .step-num {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background:
      radial-gradient(
        circle at 30% 25%,
        rgba(214, 194, 161, 0.22),
        transparent 55%
      ),
      var(--ink-900);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 800;
    font-family: "Plus Jakarta Sans", sans-serif;
    color: var(--brand-gold);
    flex-shrink: 0;
    box-shadow:
      inset 0 0 0 1px rgba(214, 194, 161, 0.35),
      0 6px 16px rgba(26, 22, 21, 0.22);
    letter-spacing: -0.01em;
  }

  .step-title {
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--ink-900);
    letter-spacing: -0.02em;
  }

  .step-desc {
    font-size: 14px;
    color: var(--ink-500);
    line-height: 1.6;
  }

  /* ── App store badges ── */
  .step-extra {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: auto;
  }

  /* ── Code block ── */
  .code-block {
    background: var(--ink-900);
    border-radius: var(--radius-sm);
    padding: 12px 16px;
    font-family: "Fragment Mono", "JetBrains Mono", monospace;
    font-size: 13px;
    color: var(--cream-100);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
  }

  /* ── "Running on a VPS?" link between subheading and cards ── */
  .vps-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 18px;
    border-radius: var(--radius-pill);
    font-size: 14px;
    font-weight: 600;
    color: var(--cream-100);
    background: var(--ink-900);
    border: 1px solid var(--ink-900);
    text-decoration: none;
    letter-spacing: -0.01em;
    box-shadow: 0 6px 16px rgba(26, 22, 21, 0.18);
    transition:
      background 0.18s ease,
      transform 0.18s ease,
      box-shadow 0.18s ease,
      gap 0.18s ease;
  }

  .vps-link span {
    color: var(--brand-gold);
  }

  .vps-link:hover {
    background: var(--ink-700);
    transform: translateY(-2px);
    box-shadow: 0 10px 22px rgba(26, 22, 21, 0.24);
    gap: 10px;
  }

  .prompt {
    color: var(--accent-green);
    user-select: none;
    font-weight: 600;
  }

  .cmd-text {
    flex: 1;
    color: var(--cream-100);
  }

  /* ── Copy button — icon only ── */
  .copy-btn {
    margin-left: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(245, 241, 232, 0.7);
    cursor: pointer;
    flex-shrink: 0;
    transition:
      background 0.18s,
      color 0.18s,
      border-color 0.18s;
  }

  .copy-btn:hover {
    background: rgba(255, 255, 255, 0.16);
    color: var(--cream-100);
    border-color: rgba(255, 255, 255, 0.24);
  }

  .copy-btn .icon-check {
    display: none;
    color: var(--accent-green);
  }

  .copy-btn.copied .icon-copy {
    display: none;
  }

  .copy-btn.copied .icon-check {
    display: block;
  }

  /* ── Flow indicator (step 3) — light chips, not a code block ── */
  .flow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    /* padding: 14px 16px;
    border-radius: var(--radius-sm);
    background: var(--cream-100);
    border: 1px solid var(--border); */
  }

  .flow-step {
    font-family: "Fragment Mono", "JetBrains Mono", monospace;
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--ink-700);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 5px 11px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .flow-arrow {
    font-size: 12px;
    color: var(--ink-500);
    flex-shrink: 0;
  }

  .flow-step--live {
    color: var(--accent-green);
    font-weight: 700;
    background: rgba(14, 161, 88, 0.1);
    border-color: rgba(14, 161, 88, 0.3);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .flow-step--live::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-green);
    box-shadow: 0 0 0 3px rgba(14, 161, 88, 0.18);
    animation: live-pulse 1.6s ease-in-out infinite;
  }

  @keyframes live-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 3px rgba(14, 161, 88, 0.18);
    }
    50% {
      box-shadow: 0 0 0 6px rgba(14, 161, 88, 0.04);
    }
  }

  @media (max-width: 600px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const btn = document.getElementById("copy-btn") as HTMLButtonElement | null;
  btn?.addEventListener("click", () => {
    const cmd = btn.dataset.cmd ?? "";
    navigator.clipboard.writeText(cmd).then(() => {
      btn.classList.add("copied");
      btn.setAttribute("aria-label", "Copied!");
      setTimeout(() => {
        btn.classList.remove("copied");
        btn.setAttribute("aria-label", "Copy command");
      }, 2000);
    });
  });
</script>
