---
import { APP_STORE_URL, PLAY_STORE_URL } from "@/data/appLinks";

const INSTALL_CMD = "npx shellular";
---

<div id="get-started">
  <div id="how-inner">
    <h2 class="section-title reveal reveal-delay-1">Up and running <span>in under a minute</span></h2>
    <p class="section-sub reveal reveal-delay-2">
      Install the app, start the host on your machine, and connect to the environment you already use.
    </p>

    <div class="steps">
      <!-- Step 1 -->
      <div class="step reveal">
        <div class="step-header">
          <div class="step-num">1</div>
          <div class="step-title">Install the app</div>
        </div>
        <p class="step-desc">Download Shellular on your phone. iOS and Android, free.</p>
        <div class="step-extra">
          <a href={APP_STORE_URL} class="store-pill" target="_blank" rel="noopener noreferrer" aria-label="Download on the App Store">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" />
            </svg>
            App Store
          </a>
          <a href={PLAY_STORE_URL} class="store-pill" target="_blank" rel="noopener noreferrer" aria-label="Get it on Google Play">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" fill="currentColor" width="14" height="14" aria-hidden="true">
              <path d="M389.6 298.3L168.9 77L449.7 238.2L389.6 298.3zM111.3 64C98.3 70.8 89.6 83.2 89.6 99.3L89.6 540.6C89.6 556.7 98.3 569.1 111.3 575.9L367.9 319.9L111.3 64zM536.5 289.6L477.6 255.5L411.9 320L477.6 384.5L537.7 350.4C555.7 336.1 555.7 303.9 536.5 289.6zM168.9 563L449.7 401.8L389.6 341.7L168.9 563z" />
            </svg>
            Google Play
          </a>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="step reveal reveal-delay-1">
        <div class="step-header">
          <div class="step-num">2</div>
          <div class="step-title">Start the host</div>
        </div>
        <p class="step-desc">One command on your machine — it connects to the relay and prints a QR code.</p>
        <div class="code-block">
          <span class="prompt" aria-hidden="true">$</span>
          <span class="cmd-text">{INSTALL_CMD}</span>
          <button class="copy-btn" id="copy-btn" data-cmd={INSTALL_CMD} aria-label="Copy command">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-copy" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="icon-check" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </button>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="step reveal reveal-delay-2">
        <div class="step-header">
          <div class="step-num">3</div>
          <div class="step-title">Scan &amp; ship</div>
        </div>
        <p class="step-desc">Scan the QR code, approve the device on the host, and your full dev environment is in your pocket.</p>
        <div class="code-block code-block--muted">
          <span class="flow-step">scan QR</span>
          <span class="flow-arrow" aria-hidden="true">→</span>
          <span class="flow-step">approve</span>
          <span class="flow-arrow" aria-hidden="true">→</span>
          <span class="flow-step flow-step--live">live</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #get-started {
    background: rgba(18, 18, 21, 0.72);
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
  }

  #how-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(60px, 8vw, 100px) clamp(16px, 8vw, 80px);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
    margin-top: 48px;
    position: relative;
    align-items: stretch;
  }

  .steps::before {
    content: "";
    position: absolute;
    left: 24px;
    right: 24px;
    top: 18px;
    height: 1px;
    background: linear-gradient(90deg, rgba(var(--brand-gold-rgb), 0.28), rgba(var(--brand-gold-rgb), 0.08));
    pointer-events: none;
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 100%;
    padding: 24px;
    border-radius: 8px;
    border: 1px solid rgba(var(--brand-gold-rgb), 0.12);
    background:
      linear-gradient(180deg, rgba(var(--brand-cream-rgb), 0.045), rgba(var(--brand-cream-rgb), 0.02)),
      rgba(14, 14, 17, 0.8);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
    position: relative;
    overflow: hidden;
    transition:
      transform 0.28s ease,
      border-color 0.28s ease,
      box-shadow 0.28s ease;
  }

  .step::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top left, rgba(var(--brand-gold-rgb), 0.12), transparent 42%);
    opacity: 0.9;
    pointer-events: none;
  }

  .step:hover {
    transform: translateY(-6px);
    border-color: rgba(var(--brand-gold-rgb), 0.24);
    box-shadow: 0 22px 48px rgba(0, 0, 0, 0.28);
  }

  .step-header {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(var(--brand-gold-rgb), 0.08);
  }

  .step-num {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--grad-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 800;
    color: var(--brand-ink);
    flex-shrink: 0;
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.18);
  }

  .step-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .step-desc {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.6;
    position: relative;
    z-index: 1;
  }

  /* ── Store pills ── */
  .step-extra {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: auto;
  }

  .store-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: 6px;
    border: 1px solid rgba(var(--brand-gold-rgb), 0.18);
    background: rgba(var(--brand-gold-rgb), 0.06);
    color: var(--accent);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition:
      background 0.2s,
      border-color 0.2s,
      transform 0.2s;
  }

  .store-pill:hover {
    background: rgba(var(--brand-gold-rgb), 0.13);
    border-color: rgba(var(--brand-gold-rgb), 0.35);
    transform: translateY(-1px);
  }

  /* ── Code block ── */
  .code-block {
    background: rgba(14, 14, 17, 0.92);
    border: 1px solid rgba(var(--brand-gold-rgb), 0.12);
    border-radius: 8px;
    padding: 12px 16px;
    font-family: "JetBrains Mono", "Courier New", monospace;
    font-size: 13px;
    color: var(--accent);
    position: relative;
    overflow: hidden;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
  }

  .code-block::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--grad-accent);
    border-radius: 8px 0 0 8px;
  }

  .prompt {
    color: rgba(180, 170, 154, 0.45);
    user-select: none;
  }

  .cmd-text {
    flex: 1;
  }

  /* ── Copy button — icon only ── */
  .copy-btn {
    margin-left: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: rgba(var(--brand-gold-rgb), 0.06);
    border: 1px solid rgba(var(--brand-gold-rgb), 0.16);
    color: rgba(var(--brand-gold-rgb), 0.6);
    cursor: pointer;
    flex-shrink: 0;
    transition:
      background 0.18s,
      color 0.18s,
      border-color 0.18s;
  }

  .copy-btn:hover {
    background: rgba(var(--brand-gold-rgb), 0.12);
    color: var(--accent);
    border-color: rgba(var(--brand-gold-rgb), 0.3);
  }

  .copy-btn .icon-check {
    display: none;
    color: var(--success, #4ade80);
  }

  .copy-btn.copied .icon-copy {
    display: none;
  }

  .copy-btn.copied .icon-check {
    display: block;
  }

  .copy-btn.copied {
    border-color: rgba(var(--brand-success-rgb), 0.3);
    background: rgba(var(--brand-success-rgb), 0.08);
  }

  /* ── Flow block (step 3) ── */
  .code-block--muted {
    color: var(--text-muted);
    gap: 0;
    justify-content: space-between;
  }

  .flow-step {
    font-size: 12px;
    letter-spacing: 0.02em;
    color: rgba(var(--brand-gold-rgb), 0.7);
  }

  .flow-arrow {
    font-size: 11px;
    color: rgba(var(--brand-gold-rgb), 0.25);
    padding: 0 6px;
  }

  .flow-step--live {
    color: var(--success, #4ade80);
    font-weight: 700;
  }

  @media (max-width: 600px) {
    .steps {
      grid-template-columns: 1fr;
    }

    .steps::before {
      display: none;
    }
  }
</style>

<script>
  const btn = document.getElementById("copy-btn") as HTMLButtonElement | null;
  btn?.addEventListener("click", () => {
    const cmd = btn.dataset.cmd ?? "";
    navigator.clipboard.writeText(cmd).then(() => {
      btn.classList.add("copied");
      btn.setAttribute("aria-label", "Copied!");
      setTimeout(() => {
        btn.classList.remove("copied");
        btn.setAttribute("aria-label", "Copy command");
      }, 2000);
    });
  });
</script>
