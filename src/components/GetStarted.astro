---
import { APP_STORE_URL, PLAY_STORE_URL } from "@/data/appLinks";

const INSTALL_CMD = "npx shellular";
---

<section id="get-started">
  <div id="how-inner">
    <div class="header">
      <h2 class="section-title reveal reveal-delay-1">
        Up and running
        <span>in under a minute.</span>
      </h2>
      <p class="section-sub reveal reveal-delay-2">
        Install the app, start the host on your machine, and connect to the environment you already use.
      </p>
    </div>

    <div class="steps">
      <!-- Step 1 -->
      <div class="step reveal">
        <div class="step-header">
          <div class="step-num">1</div>
          <div class="step-title">Install the app</div>
        </div>
        <p class="step-desc">Download Shellular on your phone. Available for both iOS and Android</p>
        <div class="step-extra">
          <a
            href={APP_STORE_URL}
            class="store-pill"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Download on the App Store"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"
              ></path>
            </svg>
            App Store
          </a>
          <a
            href={PLAY_STORE_URL}
            class="store-pill"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Get it on Google Play"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 640 640"
              fill="currentColor"
              width="14"
              height="14"
              aria-hidden="true"
            >
              <path
                d="M389.6 298.3L168.9 77L449.7 238.2L389.6 298.3zM111.3 64C98.3 70.8 89.6 83.2 89.6 99.3L89.6 540.6C89.6 556.7 98.3 569.1 111.3 575.9L367.9 319.9L111.3 64zM536.5 289.6L477.6 255.5L411.9 320L477.6 384.5L537.7 350.4C555.7 336.1 555.7 303.9 536.5 289.6zM168.9 563L449.7 401.8L389.6 341.7L168.9 563z"
              ></path>
            </svg>
            Google Play
          </a>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="step reveal reveal-delay-1">
        <div class="step-header">
          <div class="step-num">2</div>
          <div class="step-title">Start the host</div>
        </div>
        <p class="step-desc">One command on your machine — it connects to the relay and prints a QR code.</p>
        <div class="code-block">
          <span class="prompt" aria-hidden="true">$</span>
          <span class="cmd-text">{INSTALL_CMD}</span>
          <button class="copy-btn" id="copy-btn" data-cmd={INSTALL_CMD} aria-label="Copy command">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="icon-copy"
              aria-hidden="true"
            >
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="icon-check"
              aria-hidden="true"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </button>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="step reveal reveal-delay-2">
        <div class="step-header">
          <div class="step-num">3</div>
          <div class="step-title">Scan &amp; ship</div>
        </div>
        <p class="step-desc">
          Scan the QR code, approve the device on the host, and your full dev environment is in your pocket.
        </p>
        <div class="flow">
          <span class="flow-step">scan QR</span>
          <span class="flow-arrow" aria-hidden="true">→</span>
          <span class="flow-step">approve</span>
          <span class="flow-arrow" aria-hidden="true">→</span>
          <span class="flow-step flow-step--live">live</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #get-started {
    background: var(--cream-300);
    position: relative;
    overflow: hidden;
  }

  #how-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(80px, 10vw, 120px) clamp(16px, 6vw, 64px);
    position: relative;
    z-index: 1;
  }

  .header {
    text-align: center;
    margin-bottom: 48px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    margin-top: 48px;
    align-items: stretch;
    position: relative;
  }

  /* Faint connector line behind the steps on desktop */
  .steps::before {
    content: "";
    position: absolute;
    top: 46px;
    left: 12%;
    right: 12%;
    height: 2px;
    background: repeating-linear-gradient(to right, rgba(26, 22, 21, 0.18) 0 4px, transparent 4px 10px);
    z-index: 0;
    pointer-events: none;
  }

  @media (max-width: 880px) {
    .steps::before {
      display: none;
    }
  }

  .step {
    position: relative;
    z-index: 1;
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 100%;
    padding: 28px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.28s ease,
      box-shadow 0.28s ease;
    position: relative;
  }

  .step:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }

  .step-header {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .step-num {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 25%, rgba(214, 194, 161, 0.22), transparent 55%), var(--ink-900);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 800;
    font-family: "Plus Jakarta Sans", sans-serif;
    color: var(--brand-gold);
    flex-shrink: 0;
    box-shadow:
      inset 0 0 0 1px rgba(214, 194, 161, 0.35),
      0 6px 16px rgba(26, 22, 21, 0.22);
    letter-spacing: -0.01em;
  }

  .step-title {
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--ink-900);
    letter-spacing: -0.02em;
  }

  .step-desc {
    font-size: 14px;
    color: var(--ink-500);
    line-height: 1.6;
  }

  /* ── Store pills ── */
  .step-extra {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: auto;
  }

  .store-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--cream-100);
    color: var(--ink-900);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition:
      background 0.2s,
      border-color 0.2s,
      transform 0.2s;
  }

  .store-pill:hover {
    background: var(--sky-100);
    border-color: rgba(21, 108, 194, 0.3);
    color: var(--accent-blue);
    transform: translateY(-1px);
  }

  /* ── Code block ── */
  .code-block {
    background: var(--ink-900);
    border-radius: var(--radius-sm);
    padding: 12px 16px;
    font-family: "Fragment Mono", "JetBrains Mono", monospace;
    font-size: 13px;
    color: var(--cream-100);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
  }

  .prompt {
    color: var(--accent-green);
    user-select: none;
    font-weight: 600;
  }

  .cmd-text {
    flex: 1;
    color: var(--cream-100);
  }

  /* ── Copy button — icon only ── */
  .copy-btn {
    margin-left: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(245, 241, 232, 0.7);
    cursor: pointer;
    flex-shrink: 0;
    transition:
      background 0.18s,
      color 0.18s,
      border-color 0.18s;
  }

  .copy-btn:hover {
    background: rgba(255, 255, 255, 0.16);
    color: var(--cream-100);
    border-color: rgba(255, 255, 255, 0.24);
  }

  .copy-btn .icon-check {
    display: none;
    color: var(--accent-green);
  }

  .copy-btn.copied .icon-copy {
    display: none;
  }

  .copy-btn.copied .icon-check {
    display: block;
  }

  /* ── Flow indicator (step 3) — light chips, not a code block ── */
  .flow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    /* padding: 14px 16px;
    border-radius: var(--radius-sm);
    background: var(--cream-100);
    border: 1px solid var(--border); */
  }

  .flow-step {
    font-family: "Fragment Mono", "JetBrains Mono", monospace;
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--ink-700);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 5px 11px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .flow-arrow {
    font-size: 12px;
    color: var(--ink-500);
    flex-shrink: 0;
  }

  .flow-step--live {
    color: var(--accent-green);
    font-weight: 700;
    background: rgba(14, 161, 88, 0.1);
    border-color: rgba(14, 161, 88, 0.3);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .flow-step--live::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-green);
    box-shadow: 0 0 0 3px rgba(14, 161, 88, 0.18);
    animation: live-pulse 1.6s ease-in-out infinite;
  }

  @keyframes live-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 3px rgba(14, 161, 88, 0.18);
    }
    50% {
      box-shadow: 0 0 0 6px rgba(14, 161, 88, 0.04);
    }
  }

  @media (max-width: 600px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const btn = document.getElementById("copy-btn") as HTMLButtonElement | null;
  btn?.addEventListener("click", () => {
    const cmd = btn.dataset.cmd ?? "";
    navigator.clipboard.writeText(cmd).then(() => {
      btn.classList.add("copied");
      btn.setAttribute("aria-label", "Copied!");
      setTimeout(() => {
        btn.classList.remove("copied");
        btn.setAttribute("aria-label", "Copy command");
      }, 2000);
    });
  });
</script>
