<!-- Particle canvas — floating dots with connection lines for depth -->
<script is:inline>
  (function () {
    const canvas = document.getElementById("diag-particles");
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    let W,
      H,
      dpr,
      dots = [];

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function init() {
      resize();
      const count = Math.min(60, Math.round((W * H) / 8000));
      dots = Array.from({ length: count }, () => ({
        x: Math.random() * W,
        y: Math.random() * H,
        r: Math.random() * 1.5 + 0.4,
        vx: (Math.random() - 0.5) * 0.15,
        vy: (Math.random() - 0.5) * 0.12,
        phase: Math.random() * Math.PI * 2,
        speed: 0.4 + Math.random() * 0.8,
      }));
    }

    let raf;
    function frame(t) {
      ctx.clearRect(0, 0, W, H);
      const s = t / 1000;
      for (const d of dots) {
        d.x += d.vx;
        d.y += d.vy;
        if (d.x < -4) d.x = W + 4;
        if (d.x > W + 4) d.x = -4;
        if (d.y < -4) d.y = H + 4;
        if (d.y > H + 4) d.y = -4;
        const a = 0.25 + 0.25 * Math.sin(s * d.speed + d.phase);
        ctx.beginPath();
        ctx.arc(d.x, d.y, d.r, 0, Math.PI * 2);
        ctx.fillStyle = "rgba(214,194,161," + a.toFixed(3) + ")";
        ctx.fill();
      }

      // Draw faint connection lines between nearby dots
      for (let i = 0; i < dots.length; i++) {
        for (let j = i + 1; j < dots.length; j++) {
          const dx = dots[i].x - dots[j].x;
          const dy = dots[i].y - dots[j].y;
          const dist = dx * dx + dy * dy;
          if (dist < 6400) {
            const alpha = (1 - dist / 6400) * 0.08;
            ctx.beginPath();
            ctx.moveTo(dots[i].x, dots[i].y);
            ctx.lineTo(dots[j].x, dots[j].y);
            ctx.strokeStyle = "rgba(214,194,161," + alpha.toFixed(4) + ")";
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }
      }

      raf = requestAnimationFrame(frame);
    }

    // Intersection observer — only animate when visible
    const obs = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          if (!raf) raf = requestAnimationFrame(frame);
        } else {
          if (raf) {
            cancelAnimationFrame(raf);
            raf = null;
          }
        }
      },
      { threshold: 0.1 },
    );

    init();
    obs.observe(canvas);

    let resizeTimer;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(init, 150);
    });
  })();
</script>
