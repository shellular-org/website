---
const INSTALL_CMD = "npx shellular";
const APP_STORE_URL = "https://apps.apple.com/us/app/shellular/id6761985327";
const PLAY_STORE_URL = "https://play.google.com/store/apps/details?id=io.foxbiz.shellular&pcampaignid=web_share";
---

<section id="install">
  <div class="section-label reveal">Ready to start?</div>
  <h2 class="section-title reveal reveal-delay-1">One command.<br /><span>Ship from anywhere.</span></h2>
  <p class="section-sub reveal reveal-delay-2">No signup required.</p>

  <div class="install-center">
    <div class="store-links reveal reveal-delay-3" aria-label="Download Shellular app">
      <a href={APP_STORE_URL} class="store-link" target="_blank" rel="noopener noreferrer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"
          ></path>
        </svg>
        App Store
      </a>
      <a href={PLAY_STORE_URL} class="store-link" target="_blank" rel="noopener noreferrer">
        <svg width="20" height="20" viewBox="0 0 640 640" fill="currentColor" aria-hidden="true">
          <path
            d="M389.6 298.3L168.9 77L449.7 238.2L389.6 298.3zM111.3 64C98.3 70.8 89.6 83.2 89.6 99.3L89.6 540.6C89.6 556.7 98.3 569.1 111.3 575.9L367.9 319.9L111.3 64zM536.5 289.6L477.6 255.5L411.9 320L477.6 384.5L537.7 350.4C555.7 336.1 555.7 303.9 536.5 289.6zM168.9 563L449.7 401.8L389.6 341.7L168.9 563z"
          ></path>
        </svg>
        Google Play
      </a>
    </div>
    <div class="install-box reveal reveal-delay-3">
      <span class="prompt" aria-hidden="true">$</span>
      <span>{INSTALL_CMD}</span>
      <button class="copy-btn" id="copy-btn" data-cmd={INSTALL_CMD}>Copy</button>
    </div>
  </div>
</section>

<style>
  #install {
    padding: clamp(60px, 8vw, 100px) clamp(16px, 8vw, 80px);
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
  }

  .install-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .store-links {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    margin: 32px 0 4px;
  }

  .store-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text-primary);
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    border: 1px solid rgba(214, 194, 161, 0.22);
    border-radius: 12px;
    background: rgba(245, 241, 232, 0.05);
    padding: 12px 18px;
    transition:
      background 0.2s,
      border-color 0.2s,
      transform 0.2s;
  }

  .store-link:hover {
    background: rgba(214, 194, 161, 0.1);
    border-color: rgba(214, 194, 161, 0.4);
    transform: translateY(-2px);
  }

  .install-box {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    background: rgba(14, 14, 17, 0.94);
    border: 1px solid rgba(214, 194, 161, 0.16);
    border-radius: 14px;
    padding: 16px 24px;
    margin: 24px 0 36px;
    font-family: "JetBrains Mono", monospace;
    font-size: 15px;
    color: var(--accent);
  }

  .prompt {
    color: rgba(180, 170, 154, 0.56);
    user-select: none;
  }

  .copy-btn {
    background: rgba(214, 194, 161, 0.08);
    border: 1px solid rgba(214, 194, 161, 0.18);
    color: var(--accent);
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 12px;
    font-family: "Inter", sans-serif;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
    flex-shrink: 0;
  }

  .copy-btn:hover {
    background: rgba(214, 194, 161, 0.14);
  }

  .copy-btn.copied {
    color: var(--success);
    border-color: rgba(145, 197, 138, 0.32);
  }
</style>

<script>
  const btn = document.getElementById("copy-btn") as HTMLButtonElement;
  btn.addEventListener("click", () => {
    const cmd = btn.dataset.cmd ?? "";
    navigator.clipboard.writeText(cmd).then(() => {
      btn.textContent = "Copied!";
      btn.classList.add("copied");
      setTimeout(() => {
        btn.textContent = "Copy";
        btn.classList.remove("copied");
      }, 2000);
    });
  });
</script>
