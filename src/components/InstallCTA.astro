---
const INSTALL_CMD = "npx shellular start";
---

<section id="install">
  <div class="section-label reveal">Ready to start?</div>
  <h2 class="section-title reveal reveal-delay-1">One command.<br /><span>Code from anywhere.</span></h2>
  <p class="section-sub reveal reveal-delay-2">No signup required.</p>

  <div class="install-center">
    <div class="install-box reveal reveal-delay-3">
      <span class="prompt" aria-hidden="true">$</span>
      <span>{INSTALL_CMD}</span>
      <button class="copy-btn" id="copy-btn" data-cmd={INSTALL_CMD}>Copy</button>
    </div>
  </div>
</section>

<style>
  #install {
    padding: clamp(60px, 8vw, 100px) clamp(16px, 8vw, 80px);
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
  }

  .install-center {
    display: flex;
    justify-content: center;
  }

  .install-box {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    background: rgba(14, 14, 17, 0.94);
    border: 1px solid rgba(214, 194, 161, 0.16);
    border-radius: 14px;
    padding: 16px 24px;
    margin: 32px 0 36px;
    font-family: "JetBrains Mono", monospace;
    font-size: 15px;
    color: var(--accent);
  }

  .prompt {
    color: rgba(180, 170, 154, 0.56);
    user-select: none;
  }

  .copy-btn {
    background: rgba(214, 194, 161, 0.08);
    border: 1px solid rgba(214, 194, 161, 0.18);
    color: var(--accent);
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 12px;
    font-family: "Inter", sans-serif;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
    flex-shrink: 0;
  }

  .copy-btn:hover {
    background: rgba(214, 194, 161, 0.14);
  }

  .copy-btn.copied {
    color: var(--success);
    border-color: rgba(145, 197, 138, 0.32);
  }
</style>

<script>
  const btn = document.getElementById("copy-btn") as HTMLButtonElement;
  btn.addEventListener("click", () => {
    const cmd = btn.dataset.cmd ?? "";
    navigator.clipboard.writeText(cmd).then(() => {
      btn.textContent = "Copied!";
      btn.classList.add("copied");
      setTimeout(() => {
        btn.textContent = "Copy";
        btn.classList.remove("copied");
      }, 2000);
    });
  });
</script>
