---
import { Lock, Smartphone, Shield, UserCheck } from "@lucide/astro";
import SecurityDiagram from "./SecurityDiagram.astro";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const points = [
  {
    Icon: Lock,
    title: "End-to-end encrypted",
    desc: "Data is encrypted on your device before it hits our server, and decrypted only on your phone. The relay just passes it through.",
  },
  {
    Icon: Shield,
    title: "TLS in transit",
    desc: "All traffic runs over TLS — no unencrypted connections at all.",
  },
  {
    Icon: Smartphone,
    title: "Key never leaves your device",
    desc: "Pairing is done by scanning a QR code that contains the encryption key. It's never transmitted through any network.",
  },
  {
    Icon: UserCheck,
    title: "Only your devices can connect",
    desc: "Every new device must be approved by you on the host before it can connect.",
  },
];
---

{
  compact ? (
    <ul class="sec-list">
      {points.map(({ Icon, title, desc }) => (
        <li class="sec-card">
          <div class="sec-card-header">
            <div class="sec-card-icon">
              <Icon size={18} aria-hidden="true" />
            </div>
            <div class="sec-card-title">{title}</div>
          </div>
          <div class="sec-card-desc">{desc}</div>
        </li>
      ))}
    </ul>
  ) : (
    <section id="security">
      <div class="security-header">
        <h2 class="section-title reveal reveal-delay-1">
          Secure
          <span>by default.</span>
        </h2>
        <p class="section-sub reveal reveal-delay-2">
          Your code is your business. We architected Shellular so even we can't read it.
        </p>
      </div>

      <div class="reveal reveal-delay-3">
        <SecurityDiagram />
      </div>

      <ul class="sec-list reveal reveal-delay-4">
        {points.map(({ Icon, title, desc }) => (
          <li class="sec-card">
            <div class="sec-card-header">
              <div class="sec-card-icon">
                <Icon size={18} aria-hidden="true" />
              </div>
              <div class="sec-card-title">{title}</div>
            </div>
            <div class="sec-card-desc">{desc}</div>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  #security {
    padding: clamp(80px, 11vw, 130px) clamp(16px, 6vw, 64px);
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
    background: var(--cream-100);
  }

  #security .sec-list {
    margin-top: 40px;
    text-align: left;
  }

  .sec-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  @media (max-width: 600px) {
    .sec-list {
      grid-template-columns: 1fr;
    }
  }

  .sec-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition:
      border-color 0.25s,
      transform 0.25s,
      box-shadow 0.25s;
    box-shadow: var(--shadow-sm);
  }

  .sec-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .sec-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .sec-card-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--sky-100);
    border: 1px solid rgba(21, 108, 194, 0.16);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-blue);
    flex-shrink: 0;
  }

  .sec-card-title {
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: var(--ink-900);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .sec-card-desc {
    font-size: 14px;
    color: var(--ink-500);
    line-height: 1.65;
  }
</style>
