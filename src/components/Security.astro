---
import { HardDrive, Lock, Smartphone, Shield, UserCheck } from "@lucide/astro";
import SecurityDiagram from "./SecurityDiagram.astro";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const points = [
  {
    Icon: Lock,
    title: "End-to-end encrypted",
    desc: "Data is encrypted on your device before it hits our server, and decrypted only on your phone. The relay just passes it through.",
  },
  {
    Icon: Shield,
    title: "TLS in transit",
    desc: "All traffic runs over TLS — no unencrypted connections at all!",
  },
  {
    Icon: Smartphone,
    title: "Key never leaves your device",
    desc: "Pairing is done by scanning a QR code, which contains the encryption key. It is never transmitted through any network.",
  },
  {
    Icon: UserCheck,
    title: "Only your devices can connect",
    desc: "Every new device must be approved by you on the host before it can connect.",
  },
];
---

{
  compact ? (
    <ul class="sec-list">
      {points.map(({ Icon, title, desc }) => (
        <li class="sec-card">
          <div class="sec-card-header">
            <div class="sec-card-icon">
              <Icon size={18} aria-hidden="true" />
            </div>
            <div class="sec-card-title">{title}</div>
          </div>
          <div class="sec-card-desc">{desc}</div>
        </li>
      ))}
    </ul>
  ) : (
    <section id="security">
      <h2 class="section-title reveal reveal-delay-1">
        <span>Secure</span> by default
      </h2>

      <div class="reveal reveal-delay-3">
        <SecurityDiagram />
      </div>

      <ul class="sec-list reveal reveal-delay-3">
        {points.map(({ Icon, title, desc }) => (
          <li class="sec-card">
            <div class="sec-card-header">
              <div class="sec-card-icon">
                <Icon size={18} aria-hidden="true" />
              </div>
              <div class="sec-card-title">{title}</div>
            </div>
            <div class="sec-card-desc">{desc}</div>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  /* ── Landing page wrapper ────────────────────────────── */
  #security {
    padding: clamp(70px, 10vw, 110px) clamp(16px, 8vw, 80px) clamp(60px, 8vw, 100px);
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
  }

  #security .sec-list {
    margin-top: 40px;
    text-align: left;
  }

  /* ── Shared list ────────────────────────────────────── */
  .sec-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  @media (max-width: 600px) {
    .sec-list {
      grid-template-columns: 1fr;
    }
  }

  /* ── Card — mirrors Features.astro .feat-card ────────── */
  .sec-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition:
      border-color 0.25s,
      transform 0.25s,
      box-shadow 0.25s;
  }

  .sec-card:hover {
    border-color: rgba(var(--brand-gold-rgb), 0.3);
    transform: translateY(-3px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.28);
  }

  .sec-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .sec-card-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(var(--brand-gold-rgb), 0.15), rgba(var(--brand-bronze-rgb), 0.12));
    border: 1px solid rgba(var(--brand-gold-rgb), 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    flex-shrink: 0;
  }

  .sec-card-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .sec-card-desc {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.7;
  }
</style>
