---
import { FOUNDER_CALENDAR_URL } from "@/data/appLinks";
---

<main class="founder-page">
  <div class="founder-container">
    <header class="founder-header">
      <span class="eyebrow">Founder access</span>
      <h1>Talk to the <span class="h1-italic">founder.</span></h1>
      <p class="founder-lede">
        Have a question, an idea, or a workflow you want to bring to Shellular?
        Get a direct line to the person building it.
      </p>
      <a
        class="founder-cta"
        href={FOUNDER_CALENDAR_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        Book a short call
        <span class="cta-arrow" aria-hidden="true">↗</span>
      </a>
    </header>

    <section class="founder-intro" aria-labelledby="founder-intro-title">
      <div class="section-marker" aria-hidden="true">01</div>
      <div>
        <h2 id="founder-intro-title">Bring the real question.</h2>
        <p>
          Shellular puts your terminals, files, browser tools, and AI agents in
          your pocket. Tell us where your current workflow gets stuck, and we
          can work through what should come next.
        </p>
      </div>
    </section>

    <div class="founder-topics" aria-label="Conversation topics">
      <div class="topic">
        <span class="topic-number">A</span>
        <div>
          <h3>Product feedback</h3>
          <p>Share what would make your day-to-day development flow better.</p>
        </div>
      </div>
      <div class="topic">
        <span class="topic-number">B</span>
        <div>
          <h3>Teams and self-hosting</h3>
          <p>Talk through security, infrastructure, and how your team works.</p>
        </div>
      </div>
      <div class="topic">
        <span class="topic-number">C</span>
        <div>
          <h3>Partnerships</h3>
          <p>Explore integrations and ways to build better developer tools.</p>
        </div>
      </div>
    </div>

    <p class="founder-note">
      Prefer email? Reach us at
      <a href="mailto:team@shellular.dev">team@shellular.dev</a>.
    </p>
  </div>
</main>

<style>
  .founder-page {
    position: relative;
    min-height: 80vh;
    padding: 140px clamp(16px, 6vw, 64px) 120px;
    background: var(--cream-100);
    overflow: hidden;
  }

  .founder-page::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 420px;
    background:
      radial-gradient(
        ellipse 76% 66% at 50% -8%,
        rgba(255, 240, 210, 0.65) 0%,
        transparent 62%
      ),
      linear-gradient(180deg, var(--sky-100) 0%, transparent 100%);
    pointer-events: none;
  }

  .founder-container {
    position: relative;
    max-width: 820px;
    margin: 0 auto;
    z-index: 1;
  }

  .founder-header {
    max-width: 650px;
    margin: 0 auto 72px;
    text-align: center;
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: 16px;
    color: var(--brand-gold-deep);
    font-family: "Fragment Mono", "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin-bottom: 22px;
    color: var(--ink-900);
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  .h1-italic {
    color: var(--brand-gold-deep);
    font-style: italic;
    font-weight: 500;
  }

  .founder-lede {
    max-width: 50ch;
    margin: 0 auto 28px;
    color: var(--ink-700);
    font-size: 17px;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .founder-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 22px;
    color: var(--ink-900);
    background: var(--brand-gold);
    border: 1px solid var(--brand-gold-deep);
    border-radius: var(--radius-pill);
    box-shadow:
      0 8px 22px rgba(var(--brand-gold-rgb), 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.55);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition:
      background 0.2s,
      box-shadow 0.2s,
      transform 0.2s;
  }

  .founder-cta:hover {
    background: var(--brand-gold-soft);
    box-shadow:
      0 12px 30px rgba(var(--brand-gold-rgb), 0.38),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
    transform: translateY(-2px);
  }

  .cta-arrow {
    font-size: 18px;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .founder-cta:hover .cta-arrow {
    transform: translate(2px, -2px);
  }

  .founder-intro {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 18px;
    align-items: start;
    padding: 28px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .section-marker,
  .topic-number {
    color: var(--brand-gold-ink);
    font-family: "Fragment Mono", "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .founder-intro h2 {
    margin-bottom: 8px;
    font-size: 21px;
    letter-spacing: -0.025em;
  }

  .founder-intro p,
  .topic p {
    color: var(--ink-700);
    font-size: 15px;
    line-height: 1.65;
    margin: 0;
  }

  .founder-topics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    padding: 34px 0 28px;
  }

  .topic {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .topic-number {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    color: var(--ink-900);
    background: rgba(var(--brand-gold-rgb), 0.28);
    border: 1px solid rgba(var(--brand-gold-rgb), 0.48);
    border-radius: 50%;
  }

  .topic h3 {
    margin-bottom: 7px;
    font-size: 15px;
  }

  .founder-note {
    padding-top: 24px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-family: "Fragment Mono", "JetBrains Mono", monospace;
    font-size: 12px;
  }

  .founder-note a {
    color: var(--brand-gold-ink);
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .founder-page {
      padding-top: 124px;
    }

    .founder-header {
      margin-bottom: 52px;
    }

    .founder-intro {
      grid-template-columns: 42px 1fr;
      gap: 12px;
    }

    .founder-topics {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
