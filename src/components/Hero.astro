---
import HeroDiagram from "./HeroDiagram.astro";

const APP_STORE_URL = "https://apps.apple.com/us/app/shellular/id6761985327";
const PLAY_STORE_URL = "https://play.google.com/store/apps/details?id=io.foxbiz.shellular&pcampaignid=web_share";
---

<div id="hero">
  <canvas id="wave-canvas" aria-hidden="true"></canvas>

  <div class="hero-content">
    <div class="hero-copy">
      <h1 class="reveal reveal-delay-1">
        <span class="hero-copy-static">Use your</span>
        <span class="hero-rotator" aria-label="dev machine, laptop, Mac mini, EC2 box, homelab, workstation">
          <span class="hero-rotator-track" aria-hidden="true">
            <span>Mac mini</span>
            <span>laptop</span>
            <span>desktop</span>
            <span>homelab</span>
            <span>servers</span>
            <span>GPU box</span>
          </span>
        </span>
        <span class="hero-copy-static">from <span class="hero-copy-phone">your phone</span>.</span>
      </h1>
      <p class="subtitle reveal reveal-delay-2">
        Claude Code, Codex, OpenCode, and more. Access your agents, terminals, files, and ports from your phone.
      </p>

      <div class="app-badges reveal reveal-delay-3">
        <a
          href={APP_STORE_URL}
          class="app-badge"
          aria-label="Download on the App Store"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"
            ></path>
          </svg>
          <div class="badge-text">
            <span class="badge-label">Download on the</span>
            <span class="badge-store">App Store</span>
          </div>
        </a>
        <a
          href={PLAY_STORE_URL}
          class="app-badge"
          aria-label="Get it on Google Play"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 640 640"
            fill="currentColor"
            width="20"
            height="20"
            aria-hidden="true"
          >
            <path
              d="M389.6 298.3L168.9 77L449.7 238.2L389.6 298.3zM111.3 64C98.3 70.8 89.6 83.2 89.6 99.3L89.6 540.6C89.6 556.7 98.3 569.1 111.3 575.9L367.9 319.9L111.3 64zM536.5 289.6L477.6 255.5L411.9 320L477.6 384.5L537.7 350.4C555.7 336.1 555.7 303.9 536.5 289.6zM168.9 563L449.7 401.8L389.6 341.7L168.9 563z"
            ></path>
          </svg>
          <div class="badge-text">
            <span class="badge-label">Get it on</span>
            <span class="badge-store">Google Play</span>
          </div>
        </a>
      </div>
    </div>

    <HeroDiagram />
  </div>

  <canvas id="wave-overlay" aria-hidden="true"></canvas>

  <div class="scroll-hint" aria-hidden="true">
    scroll
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </div>
</div>

<style>
  #hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    background: var(--sky-bg);
  }

  #hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(10, 10, 12, 0.34) 0%, rgba(10, 10, 12, 0.18) 24%, rgba(10, 10, 12, 0.58) 100%),
      radial-gradient(circle at center, rgba(13, 13, 15, 0.02), rgba(13, 13, 15, 0.58) 78%);
    z-index: 12;
    pointer-events: none;
  }

  #wave-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0.58;
  }

  #wave-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 30;
    pointer-events: none;
    opacity: 0.32;
  }

  /* ─── Layout ─────────────────────────────────────────────── */
  .hero-content {
    position: relative;
    z-index: 40;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    align-items: center;
    grid-template-columns: minmax(360px, 0.98fr) minmax(0, 1.12fr);
    gap: clamp(28px, 3vw, 44px);
    max-width: 1400px;
    margin: 0 auto;
    padding: 116px clamp(16px, 5vw, 48px) 104px;
  }

  .hero-copy {
    text-align: left;
    max-width: 640px;
    position: relative;
  }

  .hero-copy::before {
    content: "";
    position: absolute;
    inset: -100px -80px -80px -100px;
    background: radial-gradient(
      ellipse at 28% 42%,
      rgba(10, 10, 12, 0.92) 0%,
      rgba(10, 10, 12, 0.64) 38%,
      transparent 68%
    );
    pointer-events: none;
    z-index: -1;
  }

  .hero-copy h1 {
    display: grid;
    justify-items: start;
    row-gap: 0.06em;
    font-size: clamp(2.35rem, 4.6vw, 4.3rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.04em;
    background: linear-gradient(180deg, rgba(250, 246, 240, 0.98) 0%, rgba(229, 219, 204, 0.9) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 18px;
    text-shadow: 0 14px 34px rgba(0, 0, 0, 0.22);
    /* max-width: 11.8ch; */
  }

  .hero-copy-static {
    display: inline-block;
  }

  .hero-copy-phone {
    font-style: italic;
    letter-spacing: -0.03em;
  }

  .hero-rotator {
    position: relative;
    display: inline-flex;
    align-items: flex-start;
    color: #f1c98d;
    /* width: clamp(8.2ch, 18vw, 10.8ch); */
    width: 100%;
    text-align: left;
    min-width: 0;
    height: 1.1em;
    overflow: hidden;
    vertical-align: top;
    /* mask-image: linear-gradient(180deg, transparent 0%, #000 14%, #000 86%, transparent 100%); */
    -webkit-text-fill-color: currentColor;
    text-shadow:
      0 0 18px rgba(241, 201, 141, 0.24),
      0 10px 22px rgba(0, 0, 0, 0.18);
  }

  .hero-rotator-track {
    width: 100%;
    display: flex;
    flex-direction: column;
    animation: hero-rotate-targets 16s cubic-bezier(0.7, 0, 0.3, 1) infinite;
  }

  .hero-rotator-track > span {
    display: block;
    line-height: 1.1em;
    padding-bottom: 0.02em;
    white-space: nowrap;
  }

  @keyframes hero-rotate-targets {
    0%,
    13% {
      transform: translateY(0%);
    }
    16%,
    29% {
      transform: translateY(-16.6667%);
    }
    32%,
    45% {
      transform: translateY(-33.3333%);
    }
    48%,
    61% {
      transform: translateY(-50%);
    }
    64%,
    77% {
      transform: translateY(-66.6667%);
    }
    80%,
    96% {
      transform: translateY(-83.3333%);
    }
    100% {
      transform: translateY(-83.3333%);
    }
  }

  .subtitle {
    font-size: clamp(14px, 1.5vw, 17px);
    color: rgba(240, 232, 219, 0.9);
    max-width: 48ch;
    line-height: 1.55;
    text-wrap: balance;
    margin-bottom: 24px;
  }

  /* ─── App store badges ───────────────────────────────────── */
  .app-badges {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 0;
  }

  .app-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    background-color: rgba(245, 241, 232, 0.05);
    border: 1px solid rgba(214, 194, 161, 0.22);
    border-radius: 8px;
    text-decoration: none;
    color: var(--text-primary);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition:
      background-color 0.2s,
      border-color 0.2s,
      transform 0.2s;
  }

  .app-badge:hover {
    background: rgba(214, 194, 161, 0.1);
    border-color: rgba(214, 194, 161, 0.4);
    transform: translateY(-2px);
  }

  .badge-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .badge-label {
    font-size: 10px;
    color: var(--text-muted);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .badge-store {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-primary);
  }

  /* ─── Scroll hint ────────────────────────────────────────── */
  .scroll-hint {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    color: rgba(214, 194, 161, 0.42);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    animation: bounce 2.4s infinite;
    pointer-events: none;
  }

  @keyframes bounce {
    0%,
    100% {
      transform: translateX(-50%) translateY(0);
    }
    50% {
      transform: translateX(-50%) translateY(8px);
    }
  }

  /* ─── Responsive ─────────────────────────────────────────── */
  @media (max-width: 1100px) {
    .hero-content {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: 96px;
      padding-bottom: 60px;
      gap: clamp(24px, 4vw, 36px);
      align-items: start;
    }

    .hero-copy {
      text-align: center;
      max-width: 660px;
      margin: 0 auto;
    }

    .hero-copy h1 {
      justify-items: center;
    }

    .hero-rotator {
      text-align: center;
    }

    .hero-copy::before {
      display: none;
    }

    .subtitle {
      margin: 0 auto 28px;
    }
  }

  @media (max-width: 700px) {
    .hero-copy h1 {
      row-gap: 0.02em;
      justify-items: center;
    }

    .hero-rotator {
      width: min(100%, 9.6ch);
      height: 1.1em;
      mask-image: linear-gradient(180deg, transparent 0%, #000 6%, #000 94%, transparent 100%);
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 6%, #000 94%, transparent 100%);
    }

    .scroll-hint {
      bottom: 22px;
    }

    .app-badges {
      justify-content: center;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .hero-rotator {
      min-width: 0;
      height: auto;
      mask-image: none;
    }

    .hero-rotator-track {
      animation: none;
    }

    .hero-rotator-track > span:not(:first-child) {
      display: none;
    }
  }
</style>

<!-- Wave engine — uses CDN import so we keep it inline to avoid Vite bundling -->
<script type="module" is:inline>
  import { prepareWithSegments, walkLineRanges } from "https://esm.sh/@chenglou/pretext@0.0.4";

  // Code token buckets: 0=foam/crest (dense+bright) → 3=abyss (sparse+dim)
  const BUCKETS = [
    [
      "{}",
      "()",
      "[]",
      "<>",
      "##",
      "//",
      "!=",
      "==",
      "=>",
      "+=",
      "&&",
      "||",
      "::",
      "??",
      "!",
      "++",
      "--",
      "**",
      "%%",
      "@@",
      "<<",
      ">>",
    ],
    [
      "function",
      "return",
      "const",
      "import",
      "export",
      "async",
      "await",
      "class",
      "extends",
      "interface",
      "typeof",
      "readonly",
      "private",
      "public",
      "static",
      "declare",
      "namespace",
      "enum",
      "override",
      "abstract",
    ],
    [
      "let",
      "var",
      "if",
      "for",
      "while",
      "do",
      "try",
      "catch",
      "throw",
      "new",
      "delete",
      "yield",
      "switch",
      "case",
      "break",
      "null",
      "true",
      "false",
      "void",
      "never",
      "any",
      "string",
      "number",
      "boolean",
      "unknown",
    ],
    [
      "fn",
      "ts",
      "js",
      "id",
      "ok",
      "px",
      "ms",
      "req",
      "res",
      "api",
      "url",
      "err",
      "ctx",
      "cfg",
      "buf",
      "ref",
      "arr",
      "map",
      "src",
      "dst",
      "log",
      "cmd",
      ":",
      ".",
      ":",
      ";",
      "_",
      "-",
    ],
  ];

  const FONT = '13px "JetBrains Mono","Courier New",monospace';
  const CELL_H = 20;
  const TOKEN_GAP = 6;

  // Wave layers — 5 overlapping sines for a realistic ocean shape
  const WAVES = [
    { amp: 38, freq: 0.009, speed: 0.45, phase: 0.0 },
    { amp: 18, freq: 0.0175, speed: 0.72, phase: 1.1 },
    { amp: 9, freq: 0.032, speed: 1.18, phase: 2.3 },
    { amp: 4, freq: 0.054, speed: 1.85, phase: 0.7 },
    { amp: 2, freq: 0.088, speed: 2.9, phase: 1.8 },
  ];
  const FOAM = { amp: 7, freq: 0.185, speed: 4.8, phase: 0.4 };

  let canvas, ctx, W, H, DPR;
  let oCanvas, oCtx;
  let tokenWidths = new Map();
  let rowTiles = [];
  let baseY = 0;
  let stars = [];
  let elapsed = 0;
  let lastTime = 0;
  let measured = false;

  function surfaceY(x, t) {
    let y = baseY;
    for (const w of WAVES) y += w.amp * Math.sin(x * w.freq + t * w.speed + w.phase);
    return y;
  }

  function foamAt(x, t) {
    return 0.5 + 0.5 * Math.sin(x * FOAM.freq + t * FOAM.speed + FOAM.phase);
  }

  async function measureTokens() {
    for (const bucket of BUCKETS) {
      for (const tok of bucket) {
        const prepared = prepareWithSegments(tok + " ", FONT);
        let w = 4;
        walkLineRanges(prepared, 99999, (line) => {
          w = line.width;
        });
        tokenWidths.set(tok, Math.max(w, 4));
      }
    }
    measured = true;
  }

  function buildRowTiles() {
    rowTiles = [];
    const numRows = Math.ceil(H / CELL_H) + 2;
    for (let row = 0; row < numRows; row++) {
      const cellCY = row * CELL_H + CELL_H * 0.5;
      const approxD = cellCY - baseY;
      const speed = approxD < -60 ? 5 : approxD < 0 ? 12 + (1 + approxD / 60) * 40 : Math.max(5, 52 - approxD * 0.15);

      const tokens = [],
        cumWidths = [0];
      let totalW = 0,
        col = 0;
      while (totalW < W * 2.5) {
        const depthBias = Math.min(3, Math.max(0, Math.round((approxD + 60) / 60)));
        const bi = Math.min(3, (depthBias + (col % 3 === 0 ? 0 : 1)) % 4);
        const bucket = BUCKETS[bi];
        const tok = bucket[(row * 11 + col * 13 + bi * 17) % bucket.length];
        const tw = (tokenWidths.get(tok) || 10) + TOKEN_GAP;
        tokens.push(tok);
        totalW += tw;
        cumWidths.push(totalW);
        col++;
      }
      rowTiles.push({ tokens, cumWidths, totalW, speed });
    }
  }

  function init() {
    canvas = document.getElementById("wave-canvas");
    ctx = canvas.getContext("2d");
    oCanvas = document.getElementById("wave-overlay");
    oCtx = oCanvas.getContext("2d");
    resize();
  }

  function resize() {
    DPR = Math.min(window.devicePixelRatio || 1, 2);
    W = canvas.clientWidth;
    H = canvas.clientHeight;
    canvas.width = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    oCanvas.width = W * DPR;
    oCanvas.height = H * DPR;
    oCtx.scale(DPR, DPR);
    baseY = H * 0.62;
    stars = Array.from({ length: 95 }, () => ({
      x: Math.random() * W,
      y: Math.random() * H * 0.5,
      r: Math.random() * 1.3 + 0.3,
      phase: Math.random() * Math.PI * 2,
      speed: 0.7 + Math.random() * 1.6,
    }));
    if (measured) buildRowTiles();
  }

  function drawTokenRow(renderCtx, row, t, repelEnabled) {
    const { tokens, cumWidths, totalW, speed } = rowTiles[row];
    const cellCY = row * CELL_H + CELL_H * 0.5;
    if (cellCY > H + CELL_H) return false;

    const scrollX = (elapsed * speed) % totalW;
    let lo = 0,
      hi = tokens.length - 1;
    while (lo < hi) {
      const mid = (lo + hi) >> 1;
      cumWidths[mid + 1] < scrollX ? (lo = mid + 1) : (hi = mid);
    }
    let x = cumWidths[lo > 0 ? lo - 1 : 0] - scrollX;
    let idx = lo > 0 ? lo - 1 : 0;

    while (x < W + 20) {
      const tok = tokens[((idx % tokens.length) + tokens.length) % tokens.length];
      const tw = (tokenWidths.get(tok) || 10) + TOKEN_GAP;
      const cx = x + tw * 0.5;
      const depth = cellCY - surfaceY(cx, t);
      const foam = foamAt(cx, t);

      // Repulsion from center logo area
      const rdx = cx,
        rdy = cellCY;
      const rdist = Math.sqrt(rdx * rdx + rdy * rdy);
      const REPEL_R = 145;
      const repelAlpha = Math.min(1, rdist / (REPEL_R * 0.4));
      let rx = x,
        ry = cellCY;
      if (repelEnabled && rdist < REPEL_R) {
        const f = 1 - rdist / REPEL_R;
        const push = f * f * 55;
        const nx = rdist > 0.5 ? rdx / rdist : 0;
        const ny = rdist > 0.5 ? rdy / rdist : 1;
        rx = x + nx * push * 0.4;
        ry = cellCY + ny * push;
      }

      if (!repelEnabled) {
        // Overlay pass: only draw below-surface tokens
        if (depth >= 0) {
          if (depth < 10) {
            renderCtx.globalAlpha = 0.8 + foam * 0.2;
            renderCtx.fillStyle = `rgb(${Math.round(212 + foam * 30)},${Math.round(192 + foam * 28)},${Math.round(165 + foam * 26)})`;
          } else if (depth < 50) {
            const d = (depth - 10) / 40;
            renderCtx.globalAlpha = 0.8 - d * 0.3;
            renderCtx.fillStyle = `rgb(${Math.round(163 - d * 35)},${Math.round(142 - d * 34)},${Math.round(119 - d * 26)})`;
          } else if (depth < 130) {
            const d = (depth - 50) / 80;
            renderCtx.globalAlpha = 0.5 - d * 0.27;
            renderCtx.fillStyle = `rgb(${Math.round(108 - d * 24)},${Math.round(92 - d * 26)},${Math.round(78 - d * 24)})`;
          } else {
            renderCtx.globalAlpha = 0.13;
            renderCtx.fillStyle = "#2a2522";
          }
          renderCtx.fillText(tok, x, cellCY);
          renderCtx.globalAlpha = 1;
        }
      } else {
        // Main canvas pass
        const loftBoost = (() => {
          const aboveLogo = cellCY < 0 - 0 * 0.3;
          const loftDX = Math.abs(cx);
          const loftDY = Math.max(0 - cellCY);
          const loftR = 110 + Math.sin(t * 0.6 + row * 0.4) * 20;
          return aboveLogo && loftDX < loftR ? (1 - loftDX / loftR) * Math.max(0, 1 - loftDY / 320) * 0.72 : 0;
        })();

        if (depth < -70) {
          const show = loftBoost > 0.08 ? ((idx * 71 + row * 31) & 0x7) === 0 : ((idx * 71 + row * 31) & 0xf) === 0;
          if (show) {
            renderCtx.globalAlpha = (0.07 + loftBoost * 0.38) * repelAlpha;
            renderCtx.fillStyle = loftBoost > 0 ? `rgba(237,223,198,1)` : "#a89275";
            renderCtx.fillText(tok, rx, ry);
          }
        } else if (depth < -22) {
          renderCtx.globalAlpha = (0.04 + 0.07 * (1 - (-depth - 22) / 48) + loftBoost * 0.45) * repelAlpha;
          renderCtx.fillStyle = loftBoost > 0.1 ? `rgba(244,233,214,1)` : "#b59f83";
          renderCtx.fillText(tok, rx, ry);
        } else if (depth < 0) {
          const t01 = 1 - -depth / 22;
          const f2 = foam * t01;
          renderCtx.globalAlpha = (0.18 + f2 * 0.72) * repelAlpha;
          renderCtx.fillStyle = `rgb(${Math.round(183 + f2 * 54)},${Math.round(165 + f2 * 52)},${Math.round(141 + f2 * 48)})`;
          renderCtx.fillText(tok, rx, ry);
        } else if (depth < 10) {
          renderCtx.globalAlpha = (0.8 + foam * 0.2) * repelAlpha;
          renderCtx.fillStyle = `rgb(${Math.round(212 + foam * 30)},${Math.round(192 + foam * 28)},${Math.round(165 + foam * 26)})`;
          renderCtx.fillText(tok, rx, ry);
        } else if (depth < 50) {
          const d = (depth - 10) / 40;
          renderCtx.globalAlpha = (0.8 - d * 0.3) * repelAlpha;
          renderCtx.fillStyle = `rgb(${Math.round(163 - d * 35)},${Math.round(142 - d * 34)},${Math.round(119 - d * 26)})`;
          renderCtx.fillText(tok, rx, ry);
        } else if (depth < 130) {
          const d = (depth - 50) / 80;
          renderCtx.globalAlpha = (0.5 - d * 0.27) * repelAlpha;
          renderCtx.fillStyle = `rgb(${Math.round(108 - d * 24)},${Math.round(92 - d * 26)},${Math.round(78 - d * 24)})`;
          renderCtx.fillText(tok, rx, ry);
        } else {
          renderCtx.globalAlpha = 0.13 * repelAlpha;
          renderCtx.fillStyle = "#2a2522";
          renderCtx.fillText(tok, rx, ry);
        }
        renderCtx.globalAlpha = 1;
      }

      x += tw;
      idx++;
    }
    return true;
  }

  function frame(ts) {
    if (document.hidden) {
      requestAnimationFrame(frame);
      return;
    }
    const dt = Math.min((ts - lastTime) / 1000, 0.05);
    lastTime = ts;
    elapsed += dt;
    const t = elapsed;

    // Sky gradient
    const grad = ctx.createLinearGradient(0, 0, 0, H);
    grad.addColorStop(0, "#0d0d0f");
    grad.addColorStop(0.42, "#141417");
    grad.addColorStop(0.6, "#1a1816");
    grad.addColorStop(1, "#0a0a0c");
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, W, H);

    // Stars
    for (const s of stars) {
      if (s.y >= surfaceY(s.x, t) - 10) continue;
      const a = (0.3 + 0.7 * (0.5 + 0.5 * Math.sin(t * s.speed + s.phase))) * 0.65;
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(241,231,214,${a.toFixed(3)})`;
      ctx.fill();
    }

    // Main canvas token pass
    if (measured) {
      ctx.save();
      ctx.textBaseline = "middle";
      ctx.font = FONT;
      for (let row = 0; row < rowTiles.length; row++) {
        if (!drawTokenRow(ctx, row, t, true)) break;
      }
      ctx.restore();
    }

    // Overlay pass — tokens drawn on top of logo (submerged hull effect)
    oCtx.clearRect(0, 0, W, H);
    if (measured) {
      oCtx.save();
      oCtx.textBaseline = "middle";
      oCtx.font = FONT;
      for (let row = 0; row < rowTiles.length; row++) {
        if (!drawTokenRow(oCtx, row, t, false)) break;
      }
      oCtx.restore();
    }

    requestAnimationFrame(frame);
  }

  // Resize handler
  let resizeTimer;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      resize();
      if (measured) buildRowTiles();
    }, 120);
  });

  // Boot
  init();
  await document.fonts.ready;
  await measureTokens();
  buildRowTiles();
  lastTime = performance.now();
  requestAnimationFrame(frame);
</script>
