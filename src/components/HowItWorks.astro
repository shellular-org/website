---
interface Step {
  num: number;
  title: string;
  desc: string;
  comment?: string;
  code: string;
  delay?: string;
}

const steps: Step[] = [
  {
    num: 1,
    title: "Start the CLI",
    desc: "Run the CLI agent on your laptop, desktop, or cloud server. It starts the WebSocket relay and generates a session token.",
    // comment: "# works on macOS, Linux, Windows",
    code: "npx shellular",
  },
  {
    num: 2,
    title: "Connect from the app",
    desc: "Open Shellular on iOS, Android, or the web app and scan the QR code. No manual code entry; one scan and you're in.",
    // comment: "# iOS · Android · Web — your choice",
    code: "QR → approve →  connected",
    delay: "reveal-delay-1",
  },
  {
    num: 3,
    title: "Ship",
    desc: "Agents, terminal, files, browser & DevTools. Everything you'd have at your desk — now in your pocket.",
    // comment: "# your entire dev stack, anywhere",
    code: "agents, terminals, files",
    delay: "reveal-delay-2",
  },
];
---

<div id="how">
  <div id="how-inner">
    <h2 class="section-title reveal reveal-delay-1">Set up Shellular in <span>three steps</span></h2>
    <p class="section-sub reveal reveal-delay-2">
      Install the app, start the host on your machine, and connect to the environment you already use.
    </p>

    <div class="steps">
      {
        steps.map(({ num, title, desc, comment, code, delay }) => (
          <div class={`step reveal ${delay ?? ""}`}>
            <div class="step-header">
              <div class="step-num">{num}</div>
              <div class="step-meta">
                <div class="step-title">{title}</div>
              </div>
            </div>
            <p class="step-desc">{desc}</p>
            <div class="code-block">
              {comment && <div class="code-comment" set:html={comment} />}
              <span set:html={code} />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  #how {
    background: rgba(18, 18, 21, 0.72);
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
  }

  #how-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(60px, 8vw, 100px) clamp(16px, 8vw, 80px);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
    margin-top: 48px;
    position: relative;
    align-items: stretch;
  }

  .steps::before {
    content: "";
    position: absolute;
    left: 24px;
    right: 24px;
    top: 18px;
    height: 1px;
    background: linear-gradient(90deg, rgba(var(--brand-gold-rgb), 0.28), rgba(var(--brand-gold-rgb), 0.08));
    pointer-events: none;
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 100%;
    padding: 24px;
    border-radius: 8px;
    border: 1px solid rgba(var(--brand-gold-rgb), 0.12);
    background:
      linear-gradient(180deg, rgba(var(--brand-cream-rgb), 0.045), rgba(var(--brand-cream-rgb), 0.02)),
      rgba(14, 14, 17, 0.8);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
    position: relative;
    overflow: hidden;
    transition:
      transform 0.28s ease,
      border-color 0.28s ease,
      background 0.28s ease,
      box-shadow 0.28s ease;
  }

  .step::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top left, rgba(var(--brand-gold-rgb), 0.12), transparent 42%);
    opacity: 0.9;
    pointer-events: none;
  }

  .step:hover {
    transform: translateY(-6px);
    border-color: rgba(var(--brand-gold-rgb), 0.24);
    box-shadow: 0 22px 48px rgba(0, 0, 0, 0.28);
  }

  .step-header {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(var(--brand-gold-rgb), 0.08);
  }

  .step-num {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--grad-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 800;
    color: var(--brand-ink);
    flex-shrink: 0;
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.18);
  }

  .step-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    text-align: left;
  }

  .step-desc {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.6;
    position: relative;
    z-index: 1;
    text-align: left;
  }

  .code-block {
    background: rgba(14, 14, 17, 0.92);
    border: 1px solid rgba(var(--brand-gold-rgb), 0.12);
    border-radius: 8px;
    padding: 14px 18px;
    font-family: "JetBrains Mono", "Courier New", monospace;
    font-size: 13px;
    color: var(--accent);
    margin-top: 4px;
    position: relative;
    overflow: hidden;
    z-index: 1;
  }

  .code-block::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--grad-accent);
    border-radius: 8px 0 0 8px;
  }

  .code-comment {
    color: rgba(180, 170, 154, 0.56);
    font-size: 12px;
    margin-bottom: 4px;
  }

  @media (max-width: 600px) {
    .steps {
      grid-template-columns: 1fr;
    }

    .steps::before {
      display: none;
    }
  }
</style>
