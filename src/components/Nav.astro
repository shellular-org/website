---
import ShellularLogo from "./ShellularLogo.astro";
import { ENTERPRISE_CALENDAR_URL } from "@/data/appLinks";

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const isHomePage = currentPath === "/";
---

<div id="nav-wrap">
  <nav id="nav">
    <a class="brand" href="/">
      <ShellularLogo size={26} />
      <span class="brand-text">
        Shellular
        <span class="beta-badge">beta</span>
      </span>
    </a>
    <div class="links">
      <a href={isHomePage ? "#features" : "/#features"}>Features</a>
      <a href={isHomePage ? "#security" : "/#security"}>Security</a>
      <a href="/docs">Docs</a>
      <a href={ENTERPRISE_CALENDAR_URL} target="_blank" rel="noopener noreferrer">Enterprise</a>
    </div>
    <a class="download-nav" href={isHomePage ? "#get-started" : "/#get-started"}>Get Started</a>
  </nav>
</div>

<style>
  #nav-wrap {
    position: fixed;
    top: 18px;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: center;
    padding: 0 16px;
    pointer-events: none;
  }

  #nav {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 36px);
    padding: 8px 8px 8px 22px;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(26, 22, 21, 0.07);
    border-radius: var(--radius-pill);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.6) inset,
      0 8px 24px rgba(26, 22, 21, 0.06);
    max-width: 100%;
    transition: background 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }

  #nav-wrap.scrolled #nav {
    background: rgba(255, 255, 255, 0.92);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.6) inset,
      0 14px 38px rgba(26, 22, 21, 0.12);
    border-color: rgba(26, 22, 21, 0.1);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text-primary);
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.01em;
  }

  .brand-text {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .beta-badge {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--cream-100);
    background: var(--ink-900);
    padding: 2px 7px;
    border-radius: var(--radius-pill);
  }

  .links {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2.4vw, 28px);
  }

  .links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.2s;
  }

  .links a:hover {
    color: var(--ink-900);
  }

  .download-nav {
    background: var(--ink-900);
    color: var(--cream-100);
    padding: 9px 20px;
    border-radius: var(--radius-pill);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: background 0.2s, transform 0.2s;
    border: none;
    white-space: nowrap;
  }

  .download-nav:hover {
    background: var(--ink-700);
    transform: translateY(-1px);
    color: var(--cream-100);
  }

  @media (max-width: 720px) {
    .links {
      display: none;
    }

    #nav {
      padding: 8px 8px 8px 18px;
      gap: 12px;
    }
  }
</style>

<script>
  const wrap = document.getElementById("nav-wrap");
  const update = () => {
    if (!wrap) return;
    if (window.scrollY > 24) wrap.classList.add("scrolled");
    else wrap.classList.remove("scrolled");
  };
  update();
  window.addEventListener("scroll", update, { passive: true });
</script>
