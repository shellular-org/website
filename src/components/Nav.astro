---
import ShellularLogo from "./ShellularLogo.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const isHomePage = currentPath === "/";
---

<nav id="nav">
  <a class="brand" href="/">
    <ShellularLogo size={30} />
    Shellular
  </a>
  <div class="links">
    <a href={isHomePage ? "#features" : "/#features"}>Features</a>
    <a href={isHomePage ? "#security" : "/#security"}>Security</a>
    <a href="/docs">Docs</a>
    <a class="download-nav" href={isHomePage ? "#get-started" : "/#get-started"}>Get Started</a>
  </div>
</nav>

<style>
  #nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 clamp(16px, 4vw, 48px);
    height: 60px;
    background: rgba(var(--brand-bg-rgb), 0.62);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line-soft);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text-primary);
    font-weight: 700;
    font-size: 17px;
  }

  .brand :global(svg) {
    color: var(--accent);
  }

  .links {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 32px);
  }

  .links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.2s;
  }

  .links a:hover {
    color: var(--accent);
  }

  .links .download-nav {
    background: var(--grad-accent);
    color: var(--brand-ink);
    padding: 7px 18px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: opacity 0.2s;
    border: none;
  }

  .links .download-nav:hover {
    color: var(--brand-ink);
    opacity: 0.9;
  }

  @media (max-width: 600px) {
    .links a:not(.download-nav) {
      display: none;
    }
  }
</style>
