---
import ShellularLogo from "./ShellularLogo.astro";
import { ENTERPRISE_CALENDAR_URL } from "@/data/appLinks";

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const isHomePage = currentPath === "/";
---

<nav id="nav">
  <div class="nav-container">
    <a class="brand" href="/">
      <ShellularLogo size={30} />
      <span class="brand-text">
        Shellular
        <span class="beta-badge">beta</span>
      </span>
    </a>
    <div class="links">
      <a href={isHomePage ? "#features" : "/#features"}>Features</a>
      <a href={isHomePage ? "#security" : "/#security"}>Security</a>
      <a href="/docs">Docs</a>
      <a href={ENTERPRISE_CALENDAR_URL} target="_blank" rel="noopener noreferrer">Enterprise</a>
      <a class="download-nav" href={isHomePage ? "#get-started" : "/#get-started"}>Get Started</a>
    </div>
  </div>
</nav>

<style>
  #nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: 60px;
    background: rgba(var(--brand-bg-rgb), 0.62);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line-soft);
  }

  .nav-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 clamp(16px, 5vw, 48px);
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text-primary);
    font-weight: 700;
    font-size: 17px;
  }

  .brand-text {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .beta-badge {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--brand-ink);
    background: var(--grad-accent);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .links {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 32px);
  }

  .links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.2s;
  }

  .links a:hover {
    color: var(--accent);
  }

  .links .download-nav {
    background: var(--grad-accent);
    color: var(--brand-ink);
    padding: 7px 18px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: opacity 0.2s;
    border: none;
  }

  .links .download-nav:hover {
    color: var(--brand-ink);
    opacity: 0.9;
  }

  @media (max-width: 600px) {
    .links a:not(.download-nav) {
      display: none;
    }
  }
</style>
