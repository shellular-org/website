---
import AppBadges from "@/components/AppBadges.astro";
import Footer from "@/components/Footer.astro";
import Nav from "@/components/Nav.astro";
import { APP_STORE_URL, PLAY_STORE_URL } from "@/data/appLinks";
import Layout from "@/layouts/Layout.astro";

const qrUrl = (url: string) =>
  `https://api.qrserver.com/v1/create-qr-code/?size=360x360&margin=18&data=${encodeURIComponent(url)}`;
---

<Layout
  title="Get Shellular"
  description="Download Shellular on iPhone or Android — scan the QR code to open the App Store or Google Play listing."
  noindex={true}
>
  <Nav currentPath={Astro.url.pathname} />

  <main class="share-page">
    <section class="share-shell">
      <div class="share-copy">
        <p class="eyebrow">Your entire dev environment, on your phone.</p>
        <h1>Try Shellular on your phone.</h1>
        <p>
          Terminal, AI agents, files, ports & Git — all from your phone. Choose
          your platform and scan the QR code.
        </p>

        <div
          class="platform-toggle"
          role="radiogroup"
          aria-label="Choose platform"
        >
          <button
            class="platform-button active"
            type="button"
            data-platform="ios"
            role="radio"
            aria-checked="true">iPhone</button
          >
          <button
            class="platform-button"
            type="button"
            data-platform="android"
            role="radio"
            aria-checked="false">Android</button
          >
        </div>

        <AppBadges show="ios" />
        <AppBadges show="android" className="hidden" />
      </div>

      <div
        class="qr-panel"
        data-ios-qr={qrUrl(APP_STORE_URL)}
        data-android-qr={qrUrl(PLAY_STORE_URL)}
        data-ios-url={APP_STORE_URL}
        data-android-url={PLAY_STORE_URL}
      >
        <div class="qr-frame">
          <img
            src={qrUrl(APP_STORE_URL)}
            width="360"
            height="360"
            alt="QR code for Shellular on the App Store"
            data-qr
          />
        </div>
        <div class="qr-meta">
          <span data-store-name>App Store</span>
          <a
            href={APP_STORE_URL}
            target="_blank"
            rel="noopener noreferrer"
            data-plain-link>{APP_STORE_URL}</a
          >
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .share-page {
    min-height: 100svh;
    padding: 116px clamp(18px, 5vw, 48px) 64px;
    display: grid;
    align-items: center;
  }

  .share-shell {
    width: min(1040px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(320px, 0.68fr);
    gap: clamp(28px, 6vw, 72px);
    align-items: center;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }

  h1 {
    max-width: 10ch;
    font-size: clamp(2.5rem, 6vw, 4.8rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.05em;
    margin-bottom: 20px;
    background: var(--grad-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .platform-toggle {
    width: fit-content;
    display: grid;
    grid-template-columns: repeat(2, minmax(118px, 1fr));
    gap: 6px;
    margin: 28px 0 18px;
    padding: 6px;
    border: 1px solid var(--card-border);
    background: rgba(var(--brand-bg-rgb), 0.72);
    border-radius: 999px;
  }

  .platform-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 42px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
  }

  .platform-button.active {
    background: var(--grad-accent);
    color: var(--brand-ink);
  }

  .share-copy :global(.app-badges) {
    margin-top: 28px;
  }

  .share-copy :global(.app-badges.hidden) {
    display: none;
  }

  .qr-panel {
    border: 1px solid var(--card-border);
    background: var(--surface-muted);
    border-radius: 8px;
    padding: clamp(16px, 4vw, 24px);
  }

  .qr-frame {
    background: var(--surface-soft);
    border-radius: 8px;
  }

  .qr-frame img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
  }

  .qr-meta {
    display: grid;
    gap: 7px;
    margin-top: 16px;
  }

  .qr-meta span {
    color: var(--text-primary);
    font-weight: 700;
  }

  .qr-meta a {
    color: var(--text-muted);
    font-size: 12px;
    font-family: "JetBrains Mono", monospace;
    word-break: break-all;
    text-decoration: none;
  }

  @media (max-width: 820px) {
    .share-page {
      align-items: start;
    }

    .share-shell {
      grid-template-columns: 1fr;
    }

    h1 {
      max-width: 11ch;
    }

    .platform-toggle {
      width: 100%;
    }
  }
</style>

<script>
  const panel = document.querySelector<HTMLElement>(".qr-panel");
  const buttons = document.querySelectorAll<HTMLButtonElement>(
    ".platform-button[data-platform]",
  );
  const qr = document.querySelector<HTMLImageElement>("[data-qr]");
  const plainLink =
    document.querySelector<HTMLAnchorElement>("[data-plain-link]");
  const storeName = document.querySelector<HTMLElement>("[data-store-name]");

  const content = {
    ios: {
      qr: panel?.dataset.iosQr ?? "",
      url: panel?.dataset.iosUrl ?? "",
      label: "App Store",
      alt: "QR code for Shellular on the App Store",
    },
    android: {
      qr: panel?.dataset.androidQr ?? "",
      url: panel?.dataset.androidUrl ?? "",
      label: "Google Play",
      alt: "QR code for Shellular on Google Play",
    },
  };

  const badges = document.querySelectorAll<HTMLElement>(
    ".share-copy .app-badges",
  );

  const setPlatform = (platform: keyof typeof content) => {
    const c = content[platform];
    buttons.forEach((btn) => {
      const active = btn.dataset.platform === platform;
      btn.classList.toggle("active", active);
      btn.setAttribute("aria-checked", String(active));
    });
    badges.forEach((badge, i) => {
      badge.classList.toggle("hidden", platform === "ios" ? i !== 0 : i !== 1);
    });
    if (qr) {
      qr.src = c.qr;
      qr.alt = c.alt;
    }
    if (plainLink) {
      plainLink.href = c.url;
      plainLink.textContent = c.url;
    }
    if (storeName) storeName.textContent = c.label;
  };

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const p = btn.dataset.platform;
      if (p === "ios" || p === "android") setPlatform(p);
    });
  });
</script>
