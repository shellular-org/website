---
import { Smartphone, TabletSmartphone } from "@lucide/astro";
import Footer from "@/components/Footer.astro";
import Nav from "@/components/Nav.astro";
import Layout from "@/layouts/Layout.astro";
import { APP_STORE_URL, PLAY_STORE_URL } from "@/data/appLinks";

const qrUrl = (url: string) =>
  `https://api.qrserver.com/v1/create-qr-code/?size=360x360&margin=18&data=${encodeURIComponent(url)}`;
---

<Layout title="Share Shellular" description="Share Shellular with a direct App Store or Google Play link and QR code.">
  <Nav currentPath={Astro.url.pathname} />

  <main class="share-page">
    <section class="share-shell">
      <div class="share-copy">
        <p class="section-label">Share</p>
        <h1>Send Shellular to someone nearby.</h1>
        <p>Choose their phone type and scan the QR code to open the right store listing.</p>

        <div class="platform-toggle" role="radiogroup" aria-label="Choose platform">
          <button class="platform-button active" type="button" data-platform="ios" role="radio" aria-checked="true">
            <Smartphone size={18} aria-hidden="true" />
            iOS
          </button>
          <button class="platform-button" type="button" data-platform="android" role="radio" aria-checked="false">
            <TabletSmartphone size={18} aria-hidden="true" />
            Android
          </button>
        </div>

        <a class="install-button" href={APP_STORE_URL} target="_blank" rel="noopener noreferrer" data-install-link>
          Open App Store
        </a>
      </div>

      <div
        class="qr-panel"
        data-ios-url={APP_STORE_URL}
        data-android-url={PLAY_STORE_URL}
        data-ios-qr={qrUrl(APP_STORE_URL)}
        data-android-qr={qrUrl(PLAY_STORE_URL)}
      >
        <div class="qr-frame">
          <img src={qrUrl(APP_STORE_URL)} width="360" height="360" alt="QR code for Shellular on the App Store" data-qr />
        </div>
        <div class="qr-meta">
          <span data-store-name>App Store</span>
          <a href={APP_STORE_URL} target="_blank" rel="noopener noreferrer" data-plain-link>{APP_STORE_URL}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .share-page {
    min-height: 100svh;
    padding: 116px clamp(18px, 5vw, 48px) 64px;
    display: grid;
    align-items: center;
  }

  .share-shell {
    width: min(1040px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(320px, 0.68fr);
    gap: clamp(28px, 6vw, 72px);
    align-items: center;
  }

  h1 {
    max-width: 10ch;
    font-size: clamp(2.5rem, 6vw, 4.8rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.05em;
    margin-bottom: 20px;
    background: var(--grad-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .share-copy > p:not(.section-label) {
    color: var(--text-muted);
    line-height: 1.7;
    font-size: 16px;
    max-width: 54ch;
  }

  .platform-toggle {
    width: fit-content;
    display: grid;
    grid-template-columns: repeat(2, minmax(118px, 1fr));
    gap: 6px;
    margin: 28px 0 18px;
    padding: 6px;
    border: 1px solid var(--card-border);
    background: rgba(var(--brand-bg-rgb), 0.72);
    border-radius: 999px;
  }

  .platform-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 42px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
  }

  .platform-button.active {
    background: var(--grad-accent);
    color: var(--brand-ink);
  }

  .install-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    min-width: 178px;
    padding: 0 22px;
    border-radius: 999px;
    background: var(--grad-accent-btn);
    color: var(--brand-ink);
    text-decoration: none;
    font-weight: 800;
    font-size: 14px;
  }

  .qr-panel {
    border: 1px solid var(--card-border);
    background: var(--surface-muted);
    border-radius: 8px;
    padding: clamp(16px, 4vw, 24px);
  }

  .qr-frame {
    background: var(--surface-soft);
    border-radius: 8px;
    padding: clamp(14px, 3vw, 22px);
  }

  .qr-frame img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
  }

  .qr-meta {
    display: grid;
    gap: 7px;
    margin-top: 16px;
  }

  .qr-meta span {
    color: var(--text-primary);
    font-weight: 700;
  }

  .qr-meta a {
    color: var(--text-muted);
    font-size: 12px;
    font-family: "JetBrains Mono", monospace;
    word-break: break-all;
    text-decoration: none;
  }

  @media (max-width: 820px) {
    .share-page {
      align-items: start;
    }

    .share-shell {
      grid-template-columns: 1fr;
    }

    h1 {
      max-width: 11ch;
    }

    .platform-toggle {
      width: 100%;
    }
  }
</style>

<script>
  const panel = document.querySelector<HTMLElement>(".qr-panel");
  const buttons = document.querySelectorAll<HTMLButtonElement>(".platform-button[data-platform]");
  const qr = document.querySelector<HTMLImageElement>("[data-qr]");
  const installLink = document.querySelector<HTMLAnchorElement>("[data-install-link]");
  const plainLink = document.querySelector<HTMLAnchorElement>("[data-plain-link]");
  const storeName = document.querySelector<HTMLElement>("[data-store-name]");

  const platformContent = {
    ios: {
      url: panel?.dataset.iosUrl ?? "",
      qr: panel?.dataset.iosQr ?? "",
      label: "App Store",
      cta: "Open App Store",
      alt: "QR code for Shellular on the App Store",
    },
    android: {
      url: panel?.dataset.androidUrl ?? "",
      qr: panel?.dataset.androidQr ?? "",
      label: "Google Play",
      cta: "Open Google Play",
      alt: "QR code for Shellular on Google Play",
    },
  };

  const setPlatform = (platform: keyof typeof platformContent) => {
    const content = platformContent[platform];

    buttons.forEach((button) => {
      const isActive = button.dataset.platform === platform;
      button.classList.toggle("active", isActive);
      button.setAttribute("aria-checked", String(isActive));
    });

    if (qr) {
      qr.src = content.qr;
      qr.alt = content.alt;
    }

    if (installLink) {
      installLink.href = content.url;
      installLink.textContent = content.cta;
    }

    if (plainLink) {
      plainLink.href = content.url;
      plainLink.textContent = content.url;
    }

    if (storeName) storeName.textContent = content.label;
  };

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const platform = button.dataset.platform;
      if (platform === "ios" || platform === "android") setPlatform(platform);
    });
  });
</script>
