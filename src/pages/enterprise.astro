---
import Footer from "@/components/Footer.astro";
import Nav from "@/components/Nav.astro";
import { ENTERPRISE_CALENDAR_URL } from "@/data/appLinks";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Shellular for Enterprise"
  description="Self-host Shellular's relay server on your own infrastructure for extra security, full control, and compliance. Talk to the founder."
  keywords={[
    "Shellular enterprise",
    "self-host Shellular",
    "Shellular relay server",
    "Shellular compliance",
  ]}
>
  <Nav />
  <main class="enterprise-page">
    <div class="enterprise-container">
      <header class="enterprise-header">
        <span class="eyebrow">Enterprise</span>
        <h1>Talk to <span class="h1-italic">Founder</span></h1>
        <a
          class="cta"
          href={ENTERPRISE_CALENDAR_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          Book a call
          <span class="cta-arrow" aria-hidden="true">→</span>
        </a>
      </header>

      <div class="enterprise-body">
        <p>
          Shellular lets your team access your full dev environment — AI agents
          (Claude Code, Codex, and more), terminals, files, ports, browser with
          DevTools — securely from your phones.
        </p>
        <p>
          While Shellular is fully end-to-end encrypted, this call is for
          enterprises looking to self-host Shellular's relay server on their own
          infrastructure for extra security, full control, and compliance.
        </p>
        <p>We'll discuss your setup, security requirements, and pricing.</p>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .enterprise-page {
    position: relative;
    min-height: 80vh;
    padding: 140px clamp(16px, 6vw, 64px) 120px;
    background: var(--cream-100);
    overflow: hidden;
  }

  .enterprise-page::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 360px;
    background:
      radial-gradient(
        ellipse 80% 70% at 50% -10%,
        rgba(255, 240, 210, 0.5) 0%,
        transparent 60%
      ),
      linear-gradient(180deg, var(--sky-100) 0%, transparent 100%);
    pointer-events: none;
  }

  .enterprise-container {
    position: relative;
    max-width: 660px;
    margin: 0 auto;
    z-index: 1;
  }

  .enterprise-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .eyebrow {
    display: inline-block;
    font-family: "Fragment Mono", "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-gold-deep);
    margin-bottom: 16px;
  }

  h1 {
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-size: clamp(2.2rem, 5.5vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.04;
    color: var(--ink-900);
    margin-bottom: 28px;
  }

  .h1-italic {
    font-style: italic;
    font-weight: 500;
    color: var(--brand-gold-deep);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 26px;
    background: var(--ink-900);
    color: var(--cream-100);
    border-radius: var(--radius-pill);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition:
      background 0.2s,
      transform 0.2s;
  }

  .cta:hover {
    background: var(--ink-700);
    transform: translateY(-1px);
  }

  .cta-arrow {
    transition: transform 0.2s ease;
  }

  .cta:hover .cta-arrow {
    transform: translateX(3px);
  }

  .enterprise-body {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 60ch;
    margin: 0 auto;
  }

  .enterprise-body p {
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink-700);
    text-wrap: pretty;
    margin: 0;
  }
</style>
