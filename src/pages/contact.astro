---
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Contact Us — Shellular"
  description="Contact Shellular team for support, partnerships, or general questions."
>
  <Nav />
  <main class="legal-page">
    <div class="legal-container">
      <header class="legal-header">
        <p class="section-label">Contact</p>
        <h1>Contact Us</h1>
        <p class="meta">Shellular</p>
      </header>

      <div class="legal-body">
        <section>
          <h2>Get In Touch</h2>
          <p>
            Have a question, feedback, or a partnership idea? Reach out and we will get back to you as soon as possible.
          </p>
        </section>

        <section>
          <h2>Email</h2>
          <ul>
            <li>
              <a href="mailto:team@shellular.dev">team@shellular.dev</a>
            </li>
          </ul>
        </section>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .legal-page {
    min-height: 80vh;
    padding: 80px clamp(16px, 8vw, 80px) 64px;
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
  }

  .legal-container {
    max-width: 1080px;
    width: 100%;
    margin: 0 auto;
  }

  .legal-header {
    margin-bottom: 56px;
  }

  .legal-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    background: var(--grad-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 10px;
  }

  .meta {
    font-size: 13px;
    color: var(--text-muted);
  }

  .legal-body {
    display: flex;
    flex-direction: column;
    gap: 32px;
    width: 100%;
  }

  section {
    border-top: 1px solid var(--line-soft);
    padding-top: 28px;
  }

  h2 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 14px;
    letter-spacing: -0.01em;
  }

  p,
  li,
  address {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.75;
    font-style: normal;
    overflow-wrap: anywhere;
  }

  ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  ul li {
    padding-left: 18px;
    position: relative;
  }

  ul li::before {
    content: "–";
    position: absolute;
    left: 0;
    color: var(--accent2);
  }

  a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  a:hover {
    opacity: 0.8;
  }
</style>
