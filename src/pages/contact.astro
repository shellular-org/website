---
import Footer from "@/components/Footer.astro";
import { GithubIcon, LinkedinIcon, XIcon } from "@/components/icons";
import Nav from "@/components/Nav.astro";
import Layout from "@/layouts/Layout.astro";

type Kind = "mail" | "github" | "x" | "linkedin";

const channels: { label: string; handle: string; href: string; kind: Kind }[] =
	[
		{
			label: "Email",
			handle: "team@shellular.dev",
			href: "mailto:team@shellular.dev",
			kind: "mail",
		},
		{
			label: "GitHub",
			handle: "shellular-org",
			href: "https://github.com/shellular-org",
			kind: "github",
		},
		{
			label: "X / Twitter",
			handle: "@shellular_dev",
			href: "https://x.com/shellular_dev",
			kind: "x",
		},
		{
			label: "LinkedIn",
			handle: "Shellular",
			href: "https://www.linkedin.com/company/120924584/admin/dashboard/",
			kind: "linkedin",
		},
	];
---

<Layout
  title="Contact Shellular"
  description="Contact the Shellular team for support, partnerships, product feedback, or general questions."
  keywords={["contact Shellular", "Shellular support", "Shellular partnerships"]}
>
  <Nav />
  <main class="contact-page">
    <div class="contact-container">
      <header class="contact-header">
        <h1>Say <span class="h1-italic">hello.</span></h1>
        <p class="contact-lede">
          Questions, feedback, partnerships — we read everything. Pick the channel that suits you.
        </p>
        <span class="contact-meta">
          <span class="meta-dot" aria-hidden="true"></span>
          Replies usually within a day
        </span>
      </header>

      <div class="contact-grid">
        {
          channels.map((c) => (
            <a
              class={`channel channel--${c.kind}`}
              href={c.href}
              {...(c.kind !== "mail" ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              <span class="channel-icon" aria-hidden="true">
                {c.kind === "mail" && (
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="3" y="5" width="18" height="14" rx="2.5" />
                    <path d="M3 7l9 7 9-7" />
                  </svg>
                )}
                {c.kind === "github" && <GithubIcon size={18} />}
                {c.kind === "x" && <XIcon size={18} />}
                {c.kind === "linkedin" && <LinkedinIcon size={18} />}
              </span>
              <div class="channel-body">
                <span class="channel-label">{c.label}</span>
                <span class="channel-handle">{c.handle}</span>
              </div>
              <span class="channel-arrow" aria-hidden="true">
                →
              </span>
            </a>
          ))
        }
      </div>

      <div class="contact-cmd" aria-hidden="true">
        <span class="cmd-prompt">~</span>
        <span class="cmd-arrow">›</span>
        <span class="cmd-text">echo "thanks for reaching out"</span>
        <span class="cmd-cursor"></span>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .contact-page {
    position: relative;
    min-height: 80vh;
    padding: 140px clamp(16px, 6vw, 64px) 120px;
    background: var(--cream-100);
    overflow: hidden;
  }

  .contact-page::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 360px;
    background:
      radial-gradient(ellipse 80% 70% at 50% -10%, rgba(255, 240, 210, 0.5) 0%, transparent 60%),
      linear-gradient(180deg, var(--sky-100) 0%, transparent 100%);
    pointer-events: none;
  }

  .contact-container {
    position: relative;
    max-width: 820px;
    margin: 0 auto;
    z-index: 1;
  }

  /* ── Header ──────────────────────────────────────────── */
  .contact-header {
    text-align: center;
    margin-bottom: 56px;
  }

  h1 {
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.02;
    color: var(--ink-900);
    margin-bottom: 18px;
  }

  .h1-italic {
    font-style: italic;
    font-weight: 500;
    color: var(--brand-gold-deep);
  }

  .contact-lede {
    font-size: 17px;
    color: var(--ink-700);
    line-height: 1.6;
    max-width: 52ch;
    margin: 0 auto 22px;
    text-wrap: pretty;
  }

  .contact-meta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(26, 22, 21, 0.06);
    border-radius: var(--radius-pill);
    font-family: "Fragment Mono", "JetBrains Mono", monospace;
    font-size: 12px;
    color: var(--ink-700);
    letter-spacing: 0.02em;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
  }

  .meta-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-green);
    box-shadow: 0 0 0 3px rgba(14, 161, 88, 0.18);
    animation: meta-pulse 2.4s ease-in-out infinite;
  }

  @keyframes meta-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 3px rgba(14, 161, 88, 0.18);
    }
    50% {
      box-shadow: 0 0 0 6px rgba(14, 161, 88, 0.06);
    }
  }

  /* ── Channel cards ───────────────────────────────────── */
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  .channel {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 22px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition:
      transform 0.22s ease,
      border-color 0.22s ease,
      box-shadow 0.22s ease;
  }

  .channel:hover {
    transform: translateY(-4px);
    border-color: rgba(var(--brand-gold-rgb), 0.5);
    box-shadow: var(--shadow-md);
  }

  .channel:hover .channel-arrow {
    transform: translateX(4px);
    color: var(--brand-gold-deep);
  }

  /* ── Icon tile ───────────────────────────────────────── */
  .channel-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    display: grid;
    place-items: center;
    background: var(--cream-100);
    border: 1px solid var(--border);
    color: var(--ink-700);
  }

  .channel--mail .channel-icon {
    background: rgba(var(--brand-gold-rgb), 0.16);
    border-color: rgba(var(--brand-gold-rgb), 0.32);
    color: var(--brand-gold-ink);
  }

  .channel-icon svg {
    display: block;
    transition: transform 0.22s ease;
  }

  .channel:hover .channel-icon {
    color: var(--brand-gold-ink);
    border-color: rgba(var(--brand-gold-rgb), 0.35);
    background: rgba(var(--brand-gold-rgb), 0.12);
  }

  .channel--mail:hover .channel-icon {
    background: rgba(var(--brand-gold-rgb), 0.28);
    border-color: rgba(var(--brand-gold-rgb), 0.5);
  }

  /* ── Body ────────────────────────────────────────────── */
  .channel-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .channel-label {
    font-family: "Fragment Mono", "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-gold-deep);
  }

  .channel-handle {
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: var(--ink-900);
    letter-spacing: -0.01em;
    line-height: 1.25;
    word-break: break-word;
  }

  .channel-arrow {
    flex-shrink: 0;
    font-family: "Fragment Mono", "JetBrains Mono", monospace;
    font-size: 18px;
    color: var(--ink-500);
    transition:
      transform 0.22s ease,
      color 0.22s ease;
  }

  /* ── Terminal sign-off ───────────────────────────────── */
  .contact-cmd {
    margin: 48px auto 0;
    max-width: fit-content;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: #14110f;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    font-family: "Fragment Mono", "JetBrains Mono", monospace;
    font-size: 13px;
    box-shadow: 0 14px 30px rgba(26, 22, 21, 0.18);
  }

  .contact-container > .contact-cmd {
    display: flex;
    margin: 56px auto 0;
    width: fit-content;
  }

  .cmd-prompt {
    color: var(--brand-gold);
    font-weight: 600;
  }
  .cmd-arrow {
    color: var(--accent-orange);
    font-weight: 700;
  }
  .cmd-text {
    color: rgba(245, 241, 232, 0.82);
  }

  .cmd-cursor {
    display: inline-block;
    width: 7px;
    height: 13px;
    background: var(--brand-gold);
    margin-left: 2px;
    vertical-align: middle;
    animation: cmd-blink 1.1s steps(2) infinite;
  }

  @keyframes cmd-blink {
    50% {
      opacity: 0;
    }
  }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 640px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
