---
import Footer from "@/components/Footer.astro";
import Nav from "@/components/Nav.astro";
import Layout from "@/layouts/Layout.astro";

const comparisonRows = [
	{
		label: "AI support",
		shellular:
			"Works with Claude Code, Codex, OpenCode, Pi, and the rest of your setup.",
		claude: "Built around a running Claude Code session.",
	},
	{
		label: "Scope",
		shellular:
			"Operate across terminals, files, Git, ports, and browser tooling on your machine.",
		claude:
			"Primarily continues the environment of the active Claude Code session.",
	},
	{
		label: "Interface",
		shellular:
			"Remote command center with terminal, filesystem, browser, and agent controls.",
		claude: "Remote chat interface for Claude Code sessions on web or mobile.",
	},
];

const structuredData = [
	{
		"@context": "https://schema.org",
		"@type": "WebPage",
		name: "Shellular vs Claude Remote Control",
		description:
			"Compare Shellular and Claude Remote Control for mobile remote development, agent workflows, filesystem access, and browser tooling.",
		url: "https://shellular.dev/shellular-vs-claude-remote-control",
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: "Home",
				item: "https://shellular.dev",
			},
			{
				"@type": "ListItem",
				position: 2,
				name: "Shellular vs Claude Remote Control",
				item: "https://shellular.dev/shellular-vs-claude-remote-control",
			},
		],
	},
];
---

<Layout
  title="Shellular vs Claude Remote Control | Claude Code on Your Phone"
  description="Want to use Claude Code from your phone? Shellular gives you a real terminal, file access, Git, browser DevTools, and support for Codex, OpenCode, and more — not just Claude Code remote chat."
  keywords={[
    "Claude Code mobile",
    "Claude Code on phone",
    "Claude Code from phone",
    "use Claude Code on iPhone",
    "use Claude Code on Android",
    "Claude Code phone app",
    "Claude Code remote access",
    "Claude Remote Control",
    "Shellular vs Claude Remote Control",
    "Codex mobile",
    "OpenCode mobile",
    "AI agent mobile",
    "remote development from phone",
    "mobile terminal for developers",
  ]}
  structuredData={structuredData}
>
  <Nav currentPath={Astro.url.pathname} />

  <main class="comparison-page">
    <header class="comparison-hero">
      <div class="comparison-inner">
        <h1>Shellular vs Claude Remote Control</h1>
        <p class="hero-copy">
          Claude Remote Control is useful when you want to keep a Claude Code session going from another device.
          Shellular is built for broader remote development: multiple AI agents, more than one working surface, and
          direct control over the rest of your machine from your phone.
        </p>
        <div class="hero-pills" aria-label="Key differentiators">
          <span>Not limited to Claude</span>
          <span>Not limited to one session directory</span>
          <span>Not limited to chat</span>
        </div>
      </div>
    </header>

    <section class="comparison-section">
      <div class="comparison-inner">
        <h2>Where Shellular pulls ahead</h2>
        <div class="points-grid">
          <article class="point-card">
            <h3>Use the tools you already run</h3>
            <p>
              Shellular is not tied to a single coding assistant. If your workflow spans Claude Code, Codex, OpenCode,
              Pi, or local tooling, you can keep all of it within one remote workflow.
            </p>
          </article>
          <article class="point-card">
            <h3>Move beyond one active project session</h3>
            <p>
              Claude Remote Control is centered on an existing Claude Code session. Shellular gives you broader access
              to your terminals, files, repositories, and running services so you can move across your machine instead
              of staying boxed into one agent conversation.
            </p>
          </article>
          <article class="point-card">
            <h3>Do real remote development, not just remote chat</h3>
            <p>
              Shellular combines terminal control, file browsing, Git operations, browser sessions, and DevTools. That
              matters when the next step is debugging a port, editing files, or inspecting browser behavior, not just
              sending another prompt.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="comparison-section comparison-table-section">
      <div class="comparison-inner">
        <h2>Quick comparison</h2>
        <div class="comparison-table" role="table" aria-label="Shellular compared with Claude Remote Control">
          <div class="comparison-head" role="rowgroup">
            <div class="comparison-row comparison-row-head" role="row">
              <span role="columnheader">Category</span>
              <span role="columnheader">Shellular</span>
              <span role="columnheader">Claude Remote Control</span>
            </div>
          </div>
          <div role="rowgroup">
            {
              comparisonRows.map((row) => (
                <div class="comparison-row" role="row">
                  <span class="row-label" role="cell">
                    {row.label}
                  </span>
                  <span role="cell">{row.shellular}</span>
                  <span role="cell">{row.claude}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="comparison-section comparison-close">
      <div class="comparison-inner">
        <h2>Bottom line</h2>
        <p class="hero-copy">
          If you only need to continue one Claude Code session from your phone, Claude Remote Control can do that. If
          you want a mobile-first remote development cockpit for agents, terminal work, files, browser debugging, and
          Git across your machine, Shellular is the stronger fit.
        </p>
        <a class="cta-link" href="/#install">Try Shellular</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .comparison-page {
    padding-top: 60px;
  }

  .comparison-hero {
    border-bottom: 1px solid var(--line-soft);
    background:
      radial-gradient(1100px 420px at 50% -40%, rgba(var(--brand-gold-rgb), 0.16), transparent),
      linear-gradient(180deg, rgba(var(--brand-cream-rgb), 0.02), transparent 55%), var(--brand-bg);
  }

  .comparison-inner {
    max-width: 940px;
    margin: 0 auto;
    padding: clamp(40px, 7vw, 84px) clamp(20px, 5vw, 48px);
  }

  h1 {
    font-size: clamp(2.4rem, 6vw, 4.3rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.98;
    margin: 0 0 18px;
    max-width: 12ch;
    background: var(--grad-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  h2 {
    font-size: clamp(1.35rem, 3vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0 0 14px;
  }

  h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 10px;
  }

  .hero-copy,
  .point-card p,
  .comparison-row span {
    color: var(--text-muted);
    font-size: 15px;
    line-height: 1.8;
  }

  .hero-copy {
    max-width: 70ch;
  }

  .hero-pills {
    margin-top: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hero-pills span {
    border-radius: 999px;
    padding: 8px 14px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text-primary);
    background: rgba(var(--brand-gold-rgb), 0.11);
    border: 1px solid rgba(var(--brand-gold-rgb), 0.26);
  }

  .comparison-section {
    border-bottom: 1px solid var(--line-soft);
  }

  .points-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 22px;
  }

  .point-card {
    padding: 20px;
    border-radius: 18px;
    background: rgba(var(--brand-cream-rgb), 0.03);
    border: 1px solid rgba(var(--brand-gold-rgb), 0.12);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.02),
      0 12px 28px rgba(0, 0, 0, 0.18);
  }

  .comparison-table {
    margin-top: 20px;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(var(--brand-gold-rgb), 0.14);
    background: rgba(var(--brand-cream-rgb), 0.025);
  }

  .comparison-row {
    display: grid;
    grid-template-columns: 0.9fr 1.3fr 1.3fr;
    gap: 18px;
    padding: 18px 20px;
    border-top: 1px solid rgba(var(--brand-gold-rgb), 0.1);
  }

  .comparison-row-head {
    border-top: 0;
    background: rgba(var(--brand-gold-rgb), 0.08);
  }

  .comparison-row-head span,
  .row-label {
    color: var(--text-primary);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1.5;
  }

  .comparison-close .comparison-inner {
    padding-bottom: clamp(54px, 8vw, 92px);
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    margin-top: 22px;
    padding: 11px 18px;
    border-radius: 999px;
    text-decoration: none;
    background: var(--grad-accent);
    color: var(--brand-ink);
    font-size: 14px;
    font-weight: 700;
  }

  .cta-link:hover {
    opacity: 0.92;
  }

  @media (max-width: 860px) {
    .points-grid {
      grid-template-columns: 1fr;
    }

    .comparison-row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
