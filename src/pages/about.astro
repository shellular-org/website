---
import Footer from "@/components/Footer.astro";
import Nav from "@/components/Nav.astro";
import Layout from "@/layouts/Layout.astro";

const team = [
	{
		name: "Ajit Kumar",
		url: "https://github.com/deadlyjack",
		avatarUrl: "https://github.com/deadlyjack.png",
	},
	{
		name: "Biraj",
		url: "https://github.com/biraj21",
		avatarUrl: "https://github.com/biraj21.png",
	},
	{
		name: "Raunak Raj",
		url: "https://github.com/bajrangCoder",
		avatarUrl: "https://github.com/bajrangCoder.png",
	},
];

const structuredData = [
	{
		"@context": "https://schema.org",
		"@type": "AboutPage",
		name: "About Shellular",
		description:
			"Learn about Shellular and the team building mobile-first remote development workflows.",
		url: "https://shellular.dev/about",
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: "Home",
				item: "https://shellular.dev",
			},
			{
				"@type": "ListItem",
				position: 2,
				name: "About",
				item: "https://shellular.dev/about",
			},
		],
	},
];
---

<Layout
  title="About Shellular | Team and Product Overview"
  description="Learn what Shellular does, who is building it, and how the product brings terminal, files, browser tooling, and AI agents to your phone."
  keywords={["about Shellular", "Shellular team", "remote development app", "developer workflow"]}
  structuredData={structuredData}
>
  <Nav currentPath={Astro.url.pathname} />

  <main class="about-page">
    <header class="about-hero">
      <div class="about-hero-inner">
        <h1>About <span class="h1-italic">Shellular.</span></h1>
        <p>
          Shellular is your remote command center for modern development. Spin up and supervise AI agents, execute
          terminal commands, inspect browser behavior with DevTools, browse your file system, and ship confidently with
          Git controls, all from one connected experience.
        </p>
        <div class="hero-capabilities">
          <span class="feature-highlight">AI Agents</span>
          <span>Terminal</span>
          <span class="feature-highlight">Browser + DevTools</span>
          <span>File System</span>
          <span>Git</span>
        </div>
        <div class="hero-actions">
          <a class="hero-link-card hero-link-card-primary" href="/brand">
            <span class="hero-link-label">Brand</span>
            <span class="hero-link-title">Colors and logos</span>
          </a>
          <a class="hero-link-card" href="/shellular-vs-claude-remote-control">
            <span class="hero-link-label">Compare</span>
            <span class="hero-link-title">Vs Claude Remote Control</span>
          </a>
        </div>
      </div>
    </header>

    <section class="about-section">
      <div class="about-inner">
        <h2 id="meet-humans">Meet <span class="h2-italic">the humans.</span></h2>
        <p class="section-copy">
          We are building Shellular so distributed teams can move faster with agent-powered workflows while keeping full
          visibility and control over every environment.
        </p>
        <div class="team-grid">
          {
            team.map(({ name, url, avatarUrl }) => (
              <a class="team-card" href={url} target="_blank" rel="noreferrer">
                <img class="team-avatar" src={avatarUrl} alt={`${name} avatar`} loading="lazy" />
                <div class="team-meta">
                  <span class="team-name">{name}</span>
                  <span class="team-link">GitHub ↗</span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .about-page {
    padding-top: 60px;
    background: var(--cream-100);
  }

  /* ── Hero ─────────────────────────────────────────────── */
  .about-hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse 80% 70% at 50% -20%, rgba(255, 240, 210, 0.55) 0%, transparent 60%),
      linear-gradient(180deg, var(--sky-100) 0%, var(--cream-100) 100%);
    border-bottom: 1px solid var(--border);
  }

  .about-hero-inner {
    position: relative;
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(60px, 9vw, 110px) clamp(20px, 5vw, 48px) clamp(48px, 6vw, 80px);
    z-index: 1;
  }

  h1 {
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.02;
    margin-bottom: 22px;
    color: var(--ink-900);
  }

  .h1-italic,
  .h2-italic {
    font-style: italic;
    font-weight: 500;
    color: var(--brand-gold-deep);
  }

  .about-hero p,
  .section-copy {
    color: var(--ink-700);
    font-size: 16px;
    line-height: 1.7;
    max-width: 70ch;
  }

  .hero-capabilities {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hero-capabilities span {
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-700);
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(26, 22, 21, 0.06);
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    letter-spacing: 0.02em;
  }

  .hero-capabilities .feature-highlight {
    color: var(--brand-gold-ink);
    background: rgba(var(--brand-gold-rgb), 0.18);
    border-color: rgba(var(--brand-gold-rgb), 0.36);
    font-weight: 700;
  }

  .hero-actions {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-link-card {
    display: inline-flex;
    flex-direction: column;
    gap: 5px;
    min-width: 220px;
    padding: 16px 18px;
    border-radius: var(--radius-md);
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.22s ease,
      border-color 0.22s ease,
      background-color 0.22s ease,
      box-shadow 0.22s ease;
  }

  .hero-link-card:hover {
    transform: translateY(-3px);
    border-color: var(--brand-gold);
    box-shadow: var(--shadow-md);
  }

  .hero-link-card-primary {
    background: linear-gradient(135deg, rgba(var(--brand-gold-rgb), 0.16), rgba(var(--brand-gold-rgb), 0.06));
    border-color: rgba(var(--brand-gold-rgb), 0.3);
  }

  .hero-link-label {
    font-family: "Fragment Mono", "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-gold-deep);
  }

  .hero-link-title {
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: var(--ink-900);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  /* ── Team section ─────────────────────────────────────── */
  .about-section {
    background: var(--cream-100);
  }

  .about-inner {
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(56px, 8vw, 90px) clamp(20px, 5vw, 48px) clamp(72px, 10vw, 120px);
  }

  h2 {
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink-900);
    margin-bottom: 14px;
    line-height: 1.1;
  }

  .team-grid {
    margin-top: 36px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .team-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px;
    border-radius: var(--radius-lg);
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.22s ease,
      border-color 0.22s ease,
      box-shadow 0.22s ease;
    position: relative;
    overflow: hidden;
  }

  .team-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--brand-gold);
    opacity: 0;
    transition: opacity 0.22s ease;
  }

  .team-card:hover {
    transform: translateY(-4px);
    border-color: rgba(var(--brand-gold-rgb), 0.45);
    box-shadow: var(--shadow-md);
  }

  .team-card:hover::before {
    opacity: 1;
  }

  .team-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid var(--cream-100);
    box-shadow: 0 2px 10px rgba(26, 22, 21, 0.1);
  }

  .team-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .team-name {
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
    color: var(--ink-900);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .team-link {
    font-family: "Fragment Mono", "JetBrains Mono", monospace;
    color: var(--brand-gold-deep);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  @media (max-width: 760px) {
    .hero-actions { flex-direction: column; }
    .hero-link-card { min-width: 0; }
    .team-grid { grid-template-columns: 1fr; }
  }
</style>
