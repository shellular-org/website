---
import Footer from "@/components/Footer.astro";
import Nav from "@/components/Nav.astro";
import Layout from "@/layouts/Layout.astro";

const team = [
  { name: "Ajit Kumar", url: "https://github.com/deadlyjack", avatarUrl: "https://github.com/deadlyjack.png" },
  { name: "Biraj", url: "https://github.com/biraj21", avatarUrl: "https://github.com/biraj21.png" },
  { name: "Raunaj Raj", url: "https://github.com/bajrangCoder", avatarUrl: "https://github.com/bajrangCoder.png" },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "About Shellular",
  description: "Learn about Shellular and the team building mobile-first remote development workflows.",
  url: "https://shellular.dev/about",
};
---

<Layout
  title="About Shellular | Team and Product Overview"
  description="Learn what Shellular does, who is building it, and how the product brings terminal, files, browser tooling, and AI agents to your phone."
  keywords={["about Shellular", "Shellular team", "remote development app", "developer workflow"]}
  structuredData={structuredData}
>
  <Nav currentPath={Astro.url.pathname} />

  <main class="about-page">
    <header class="about-hero">
      <div class="about-hero-inner">
        <p class="section-label">About</p>
        <h1>Shellular</h1>
        <p>
          Shellular is your remote command center for modern development. Spin up and supervise AI agents, execute
          terminal commands, inspect browser behavior with DevTools, browse your file system, and ship confidently with
          Git controls, all from one connected experience.
        </p>
        <div class="hero-capabilities">
          <span class="feature-highlight">AI Agents</span>
          <span>Terminal</span>
          <span class="feature-highlight">Browser + DevTools</span>
          <span>File System</span>
          <span>Git</span>
        </div>
        <a class="brand-link" href="/brand">Brand colors and logos</a>
      </div>
    </header>

    <section class="about-section">
      <div class="about-inner">
        <h2 id="meet-humans">Meet The Humans of Shellular</h2>
        <p class="section-copy">
          We are building Shellular so distributed teams can move faster with agent-powered workflows while keeping full
          visibility and control over every environment.
        </p>
        <div class="team-grid">
          {
            team.map(({ name, url, avatarUrl }) => (
              <a class="team-card" href={url} target="_blank" rel="noreferrer">
                <img class="team-avatar" src={avatarUrl} alt={`${name} avatar`} loading="lazy" />
                <div class="team-meta">
                  <span class="team-name">{name}</span>
                  <span class="team-link">GitHub ↗</span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .about-page {
    padding-top: 60px;
  }

  .about-hero {
    border-bottom: 1px solid var(--line-soft);
    background: radial-gradient(1200px 360px at 50% -50%, rgba(var(--brand-gold-rgb), 0.14), transparent), var(--brand-bg);
  }

  .about-hero-inner {
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(44px, 8vw, 90px) clamp(20px, 5vw, 48px) clamp(34px, 5vw, 54px);
  }

  .about-inner {
    max-width: 860px;
    margin: 0 auto;
    padding: 46px clamp(20px, 5vw, 48px);
  }

  .section-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent2);
    margin-bottom: 16px;
  }

  h1 {
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
    margin-bottom: 18px;
    background: var(--grad-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .about-hero p,
  .section-copy {
    color: var(--text-muted);
    font-size: 15px;
    line-height: 1.8;
    max-width: 70ch;
  }

  .hero-capabilities {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .brand-link {
    display: inline-flex;
    margin-top: 20px;
    color: var(--accent);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }

  .brand-link:hover {
    text-decoration: underline;
  }

  .hero-capabilities span {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
    background: rgba(var(--brand-gold-rgb), 0.05);
    border: 1px solid rgba(var(--brand-gold-rgb), 0.11);
    padding: 5px 12px;
    border-radius: 999px;
  }

  .hero-capabilities .feature-highlight {
    color: var(--accent);
    background: rgba(var(--brand-gold-rgb), 0.14);
    border-color: rgba(var(--brand-gold-rgb), 0.32);
    font-weight: 600;
  }

  .section-pill {
    flex-shrink: 0;
    padding: 13px 16px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition:
      color 0.18s,
      border-color 0.18s;
  }

  .section-pill:hover {
    color: var(--accent);
    border-bottom-color: var(--accent2);
  }

  .about-section {
    border-bottom: 1px solid var(--line-soft);
  }

  h2 {
    font-size: clamp(1.25rem, 3vw, 1.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 12px;
  }

  .team-grid {
    margin-top: 22px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .team-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px;
    border-radius: 16px;
    text-decoration: none;
    background: rgba(var(--brand-cream-rgb), 0.03);
    border: 1px solid rgba(var(--brand-gold-rgb), 0.12);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.02),
      0 10px 24px rgba(0, 0, 0, 0.2);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .team-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(var(--brand-gold-rgb), 0.24);
  }

  .team-meta {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .team-card:hover {
    transform: translateY(-3px);
    border-color: rgba(var(--brand-gold-rgb), 0.28);
    background: rgba(var(--brand-gold-rgb), 0.065);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.03),
      0 16px 34px rgba(0, 0, 0, 0.28);
  }

  .team-name {
    color: var(--text-primary);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
  }

  .team-link {
    color: var(--accent2);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  @media (max-width: 760px) {
    .team-grid {
      grid-template-columns: 1fr;
    }

    .about-inner {
      padding: 38px clamp(20px, 5vw, 48px);
    }
  }
</style>
