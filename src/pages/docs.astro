---
import Footer from "@/components/Footer.astro";
import Nav from "@/components/Nav.astro";
import Security from "@/components/Security.astro";
import Layout from "@/layouts/Layout.astro";

const commands = [
  { cmd: "shellular", desc: "Run Shellular in the foreground" },
  { cmd: "shellular start", desc: "Start the background host and print the QR code" },
  { cmd: "shellular stop", desc: "Stop the background host" },
  { cmd: "shellular status", desc: "Show host status, PID, restart count, and logs" },
  { cmd: "shellular logs", desc: "Stream background host logs" },
  { cmd: "shellular clients", desc: "Review and approve known client devices" },
];

const options = [
  { flag: "--server <url>", def: "wss://api.shellular.dev", desc: "Relay server WebSocket URL" },
  { flag: "--dir <path>", def: "$HOME", desc: "Root directory exposed to the client" },
  {
    flag: "--unknown-clients <policy>",
    def: "requires-approval",
    desc: "How unknown clients are handled: always-reject, always-allow, or requires-approval",
  },
];

const clientsOptions = [{ flag: "--delete <clientId>", desc: "Delete a known client from the store" }];

const sections = [
  { id: "overview", label: "Overview" },
  { id: "requirements", label: "Requirements" },
  { id: "quick-start", label: "Quick start" },
  { id: "background-mode", label: "Background mode" },
  { id: "commands", label: "Commands" },
  { id: "options", label: "Options" },
  { id: "client-approval", label: "Client approval" },
  { id: "security", label: "Security" },
];
---

<Layout
  title="Shellular CLI Docs | Install and Manage the Host Agent"
  description="Documentation for installing, starting, and managing the Shellular CLI host agent, including commands, options, approvals, and security."
  keywords={["Shellular CLI", "Shellular docs", "remote CLI", "developer tool documentation", "host agent"]}
>
  <Nav currentPath={Astro.url.pathname} />

  <main class="docs-page">
    <!-- Hero -->
    <header class="docs-hero">
      <div class="docs-hero-inner">
        <p class="section-label">Documentation</p>
        <h1>Shellular CLI</h1>

        <div>
          <h4 style="color: var(--text-muted); font-weight: normal;">Get started in just 3 steps:</h4>
          <ol class="hero-steps">
            <li>
              Run <code>npx shellular</code>
            </li>
            <li>Scan the QR code with the Shellular app</li>
            <li>Approve the device</li>
          </ol>
          <div class="hero-features">
            <span>Terminal</span>
            <span class="feature-highlight">Agents</span>
            <span>Files</span>
            <span>Git</span>
            <span class="feature-highlight">Browser &amp; DevTools</span>
            <span>Resource Monitor</span>
            <span>Ports</span>
          </div>
        </div>

        <div class="hero-actions">
          <a class="btn-primary" href="#quick-start">Quick start</a>
          <a class="btn-secondary" href="https://www.npmjs.com/package/shellular" target="_blank" rel="noreferrer"
            >npm package ↗</a
          >
        </div>
      </div>
    </header>

    <!-- Sticky section nav -->
    <nav class="section-nav" aria-label="Page sections">
      <div class="section-nav-inner">
        {
          sections.map((s) => (
            <a href={`#${s.id}`} class="section-pill">
              {s.label}
            </a>
          ))
        }
      </div>
    </nav>

    <!-- Content -->
    <div class="docs-body">
      <section id="overview" class="doc-section">
        <h2>Overview</h2>
        <p>
          Shellular CLI is the host agent for Shellular. It connects your dev machine to the Shellular relay so the
          mobile app can reach your environment securely.
        </p>
        <p>
          If you are comparing mobile remote development setups, read
          <a class="inline-link" href="/shellular-vs-claude-remote-control">Shellular vs Claude Remote Control</a>
          for the short version of where Shellular fits.
        </p>
      </section>

      <section id="requirements" class="doc-section">
        <h2>Requirements</h2>
        <ul class="check-list">
          <li>Node.js v20.20.2 or newer</li>
          <li>macOS, Linux, or Windows</li>
          <li>The Shellular mobile app to scan the pairing QR code</li>
        </ul>
      </section>

      <section id="quick-start" class="doc-section">
        <h2>Quick start</h2>
        <p>Start the CLI directly with npx — no install needed:</p>
        <div class="code-block">
          <span class="code-label">terminal</span>
          <pre><code>npx shellular</code></pre>
        </div>
        <p>
          The CLI prints a QR code in your terminal. Scan it with the Shellular app to pair your device and connect. By
          default, every unknown client must be approved before it can connect.
        </p>
      </section>

      <section id="background-mode" class="doc-section">
        <h2>Background mode</h2>
        <p>To keep Shellular running after you close your terminal:</p>
        <div class="code-block">
          <span class="code-label">terminal</span>
          <pre><code>npx shellular start</code></pre>
        </div>
        <p>
          In daemon mode, clients are not approved interactively. Run <code>shellular clients</code> to review pending devices
          and approve them from any terminal.
        </p>
        <p>Stop the host when you are done:</p>
        <div class="code-block">
          <span class="code-label">terminal</span>
          <pre><code>npx shellular stop</code></pre>
        </div>
        <div class="callout">
          <strong>Note</strong>
          <p>Only one instance of Shellular can run at a time per machine.</p>
        </div>
      </section>

      <section id="commands" class="doc-section">
        <h2>Commands</h2>
        <div class="cmd-list">
          {
            commands.map(({ cmd, desc }) => (
              <div class="cmd-row">
                <code class="cmd-name">{cmd}</code>
                <span class="cmd-desc">{desc}</span>
              </div>
            ))
          }
        </div>
      </section>

      <section id="options" class="doc-section">
        <h2>Options</h2>
        <p>Global flags that apply to all commands:</p>
        <div class="opt-list">
          {
            options.map(({ flag, def, desc }) => (
              <div class="opt-row">
                <div class="opt-meta">
                  <code class="opt-flag">{flag}</code>
                  <span class="opt-default">
                    default: <code>{def}</code>
                  </span>
                </div>
                <span class="opt-desc">{desc}</span>
              </div>
            ))
          }
        </div>
        <h3 class="subsection-title"><code>shellular clients</code> flags</h3>
        <div class="opt-list">
          {
            clientsOptions.map(({ flag, desc }) => (
              <div class="opt-row">
                <div class="opt-meta">
                  <code class="opt-flag">{flag}</code>
                </div>
                <span class="opt-desc">{desc}</span>
              </div>
            ))
          }
        </div>
      </section>

      <section id="client-approval" class="doc-section">
        <h2>Unknown client approval</h2>
        <p>
          <code>--unknown-clients</code> only applies to devices not already in the local approvals file. Once a client is
          approved or rejected it is remembered.
        </p>
        <div class="policy-list">
          <div class="policy-row">
            <code class="policy-name">requires-approval</code>
            <p>
              Default. In foreground mode the CLI asks interactively. In daemon mode the connection is held pending
              until you run <code>shellular clients</code>.
            </p>
          </div>
          <div class="policy-row">
            <code class="policy-name">always-allow</code>
            <p>Accepts unknown clients immediately without writing to the approvals file.</p>
          </div>
          <div class="policy-row">
            <code class="policy-name">always-reject</code>
            <p>Rejects unknown clients immediately without writing to the approvals file.</p>
          </div>
        </div>
      </section>

      <section id="security" class="doc-section">
        <h2>Security</h2>
        <Security compact />
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* ── Page shell ───────────────────────────────────────── */
  .docs-page {
    padding-top: 60px; /* clears fixed Nav */
  }

  /* ── Hero ─────────────────────────────────────────────── */
  .docs-hero {
    border-bottom: 1px solid var(--line-soft);
    background: var(--brand-bg);
  }

  .docs-hero-inner {
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(40px, 7vw, 80px) clamp(20px, 5vw, 48px) clamp(36px, 5vw, 60px);
  }

  .docs-hero-inner .section-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent2);
    margin-bottom: 16px;
  }

  .docs-hero-inner h1 {
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
    margin-bottom: 20px;
    background: var(--grad-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-steps {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 20px;
    counter-reset: steps;
  }

  .hero-steps li {
    counter-increment: steps;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .hero-steps li::before {
    content: counter(steps);
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(var(--brand-gold-rgb), 0.1);
    border: 1px solid var(--card-border);
    display: inline-grid;
    place-items: center;
    font-size: 11px;
    font-weight: 700;
    color: var(--accent2);
    font-family: "JetBrains Mono", monospace;
  }

  .hero-features {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .hero-features span {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
    background: rgba(var(--brand-gold-rgb), 0.05);
    border: 1px solid rgba(var(--brand-gold-rgb), 0.1);
    padding: 4px 12px;
    border-radius: 20px;
  }

  .hero-features .feature-highlight {
    color: var(--accent);
    background: rgba(var(--brand-gold-rgb), 0.12);
    border-color: rgba(var(--brand-gold-rgb), 0.32);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
  }

  /* ── Section nav ──────────────────────────────────────── */
  .section-nav {
    position: sticky;
    top: 60px;
    z-index: 40;
    border-bottom: 1px solid var(--line-soft);
    background: rgba(var(--brand-bg-rgb), 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .section-nav-inner {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 48px);
    display: flex;
    gap: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .section-nav-inner::-webkit-scrollbar {
    display: none;
  }

  .section-pill {
    flex-shrink: 0;
    padding: 14px 16px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition:
      color 0.18s,
      border-color 0.18s;
    white-space: nowrap;
  }

  .section-pill:hover {
    color: var(--accent);
    border-bottom-color: var(--accent2);
  }

  /* ── Docs body ────────────────────────────────────────── */
  .docs-body {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 48px) 96px;
  }

  /* ── Section ──────────────────────────────────────────── */
  .doc-section {
    padding: 48px 0 44px;
    border-bottom: 1px solid var(--line-soft);
  }

  .doc-section:last-child {
    border-bottom: none;
  }

  .doc-section h2 {
    font-size: clamp(1.25rem, 3vw, 1.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 18px;
  }

  .doc-section p {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-muted);
  }

  .doc-section p + p,
  .doc-section p + .code-block,
  .doc-section .code-block + p,
  .doc-section p + .callout,
  .doc-section p + ul {
    margin-top: 16px;
  }

  /* ── Inline code ──────────────────────────────────────── */
  code {
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    color: var(--accent);
  }

  p code,
  li code {
    background: rgba(var(--brand-gold-rgb), 0.08);
    border: 1px solid var(--card-border);
    padding: 2px 7px;
    border-radius: 6px;
  }

  /* ── Code block ───────────────────────────────────────── */
  .code-block {
    position: relative;
    margin-top: 16px;
    border-radius: 16px;
    border: 1px solid rgba(var(--brand-gold-rgb), 0.14);
    background: var(--brand-bg-deep);
    overflow: hidden;
  }

  .code-label {
    display: block;
    padding: 8px 16px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent2);
    border-bottom: 1px solid rgba(var(--brand-gold-rgb), 0.08);
  }

  .code-block pre {
    margin: 0;
    padding: 18px 20px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    background: transparent;
    border: none;
    border-radius: 0;
  }

  .code-block pre code {
    font-size: 14px;
    color: var(--accent);
  }

  /* ── Check list ───────────────────────────────────────── */
  .check-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
    margin-top: 4px;
  }

  .check-list li {
    padding: 14px 16px 14px 44px;
    position: relative;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
    border-radius: 12px;
    background: rgba(var(--brand-cream-rgb), 0.03);
    border: 1px solid rgba(var(--brand-gold-rgb), 0.08);
  }

  .check-list li::before {
    content: "✓";
    position: absolute;
    left: 16px;
    top: 14px;
    font-size: 13px;
    color: var(--accent2);
    font-weight: 700;
  }

  /* ── Commands list ────────────────────────────────────── */
  .cmd-list {
    display: grid;
    gap: 8px;
    margin-top: 4px;
  }

  .cmd-row {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 14px 18px;
    border-radius: 12px;
    background: rgba(var(--brand-cream-rgb), 0.025);
    border: 1px solid rgba(var(--brand-gold-rgb), 0.08);
    flex-wrap: wrap;
  }

  .cmd-name {
    flex-shrink: 0;
    font-size: 13px;
    color: var(--accent);
    background: rgba(var(--brand-gold-rgb), 0.08);
    border: 1px solid var(--card-border);
    padding: 3px 10px;
    border-radius: 8px;
    white-space: nowrap;
  }

  .cmd-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* ── Options list ─────────────────────────────────────── */
  .opt-list {
    display: grid;
    gap: 10px;
    margin-top: 4px;
  }

  .opt-row {
    padding: 16px 18px;
    border-radius: 14px;
    background: rgba(var(--brand-cream-rgb), 0.025);
    border: 1px solid rgba(var(--brand-gold-rgb), 0.08);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .opt-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .opt-flag {
    font-size: 13px;
    color: var(--accent);
    background: rgba(var(--brand-gold-rgb), 0.08);
    border: 1px solid var(--card-border);
    padding: 3px 10px;
    border-radius: 8px;
    white-space: nowrap;
  }

  .opt-default {
    font-size: 12px;
    color: var(--accent2);
  }

  .opt-default code {
    font-size: 12px;
    color: var(--accent2);
    background: none;
    border: none;
    padding: 0;
  }

  .opt-desc {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .subsection-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-muted);
    margin: 24px 0 10px;
    letter-spacing: 0.01em;
  }

  .subsection-title code {
    font-size: 13px;
    color: var(--accent);
    background: rgba(var(--brand-gold-rgb), 0.08);
    border: 1px solid var(--card-border);
    padding: 2px 7px;
    border-radius: 6px;
  }

  /* ── Policy list ──────────────────────────────────────── */
  .policy-list {
    display: grid;
    gap: 10px;
    margin-top: 18px;
  }

  .policy-row {
    padding: 16px 18px;
    border-radius: 14px;
    background: rgba(var(--brand-cream-rgb), 0.025);
    border: 1px solid rgba(var(--brand-gold-rgb), 0.08);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .policy-name {
    align-self: flex-start;
    font-size: 13px;
    color: var(--accent);
    background: rgba(var(--brand-gold-rgb), 0.08);
    border: 1px solid var(--card-border);
    padding: 3px 10px;
    border-radius: 8px;
  }

  .policy-row p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0;
  }

  /* ── Callout ──────────────────────────────────────────── */
  .callout {
    margin-top: 18px;
    padding: 16px 18px;
    border-radius: 14px;
    background: rgba(var(--brand-gold-rgb), 0.05);
    border: 1px solid rgba(var(--brand-gold-rgb), 0.14);
  }

  .callout strong {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .callout p {
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  /* ── Responsive ───────────────────────────────────────── */
  @media (max-width: 600px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }

    .cmd-row {
      flex-direction: column;
      gap: 8px;
      align-items: flex-start;
    }

    .docs-hero-inner h1 {
      font-size: 2rem;
    }

    .section-pill {
      padding: 12px 12px;
      font-size: 12px;
    }

    .doc-section {
      padding: 36px 0 32px;
    }
  }
</style>
